#!/usr/bin/env bash
# pre-commit shim: refuse a commit while MAP.md is out of date.
#
# MAP.md is generated by scripts/map.py (never hand-edited). This hook runs the
# drift check only: it never rewrites MAP.md, so a commit cannot change files behind
# your back. If it fails, regenerate and stage the result:
#     python3 scripts/map.py && git add MAP.md
#
# Enabled by `git config core.hooksPath .githooks` (cut-project.sh sets this in a
# freshly seeded repo and only prints it for a retrofit). It is a convenience, not a
# lock: `git commit --no-verify` skips it, and there is deliberately no CI job.
# Bash 3.2-safe.
set -u

# Run from the repo root wherever git or a human started us (this file is <root>/.githooks/pre-commit).
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

# Without python3 or the script there is nothing to check; say so and do not block.
if ! command -v python3 >/dev/null 2>&1 || [ ! -f scripts/map.py ]; then
  echo "pre-commit: skipping the MAP.md check (python3 or scripts/map.py not found)"
  exit 0
fi

if out="$(python3 scripts/map.py --check 2>&1)"; then
  exit 0
fi

# Show why, and make sure the fix is named exactly once (map.py names it for drift,
# not for an error such as an over-budget map).
printf '%s\n' "$out"
case "$out" in
  *"run: python3 scripts/map.py"*) ;;
  *) echo "run: python3 scripts/map.py" ;;
esac
exit 1
