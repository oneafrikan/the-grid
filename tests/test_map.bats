#!/usr/bin/env bats
# scripts/map.py (change `charter-files`, spec `repo-map`): generates MAP.md, checks drift,
# prints status counts. Every case runs against a throwaway root under a temp dir; nothing
# here ever writes into the real repo.

load helpers/setup

setup() {
  common_setup
  MAP="$REPO_ROOT/scripts/map.py"
  R=$(mktemp -d)
}

teardown() {
  rm -rf "$R"
  common_teardown
}

# gen — run the generator against the fixture root.
gen() { python3 "$MAP" --root "$R"; }

# put <rel path> [content] — create a file (and parents) in the fixture root.
put() {
  mkdir -p "$(dirname "$R/$1")"
  printf '%s\n' "${2:-x}" > "$R/$1"
}

# canon_entry <n> <claim> — a minimal canon entry with frontmatter.
canon_entry() {
  mkdir -p "$R/knowledge/canon"
  printf -- '---\nclaim: %s\nstage: canonical\n---\nbody\n' "$2" > "$R/knowledge/canon/K-$(printf '%03d' "$1")-x.md"
}

# entry <stage> <name> — a knowledge entry with the given stage under knowledge/<stage>/.
entry() {
  mkdir -p "$R/knowledge/$1"
  printf -- '---\nclaim: a claim\nstage: %s\n---\nbody\n' "$1" > "$R/knowledge/$1/$2.md"
}

# a small agent-factory fixture: one project with an orchestrator and two reports
mk_factory() {
  mkdir -p "$R/agent-factory/examples"
  cat > "$R/agent-factory/examples/demo.yaml" <<'EOF'
project: demo
agents:
  - role: boss   # trailing comment
    delegates_to: [alpha, beta]
  - role: alpha
  - role: beta
  - role: lead
    delegates_to:
      - gamma
      - delta
  - role: gamma
  - role: delta
EOF
}

@test "map.py is valid Python 3.8 syntax and uses only the standard library" {
  run python3 - "$MAP" <<'EOF'
import ast, sys
src = open(sys.argv[1], encoding="utf-8").read()
tree = ast.parse(src, feature_version=(3, 8))
std = set(sys.stdlib_module_names) if hasattr(sys, "stdlib_module_names") else None
bad = []
for node in ast.walk(tree):
    mods = []
    if isinstance(node, ast.Import):
        mods = [a.name.split(".")[0] for a in node.names]
    elif isinstance(node, ast.ImportFrom) and node.module:
        mods = [node.module.split(".")[0]]
    for m in mods:
        if std is not None and m not in std:
            bad.append(m)
print("non-stdlib:", bad)
sys.exit(1 if bad else 0)
EOF
  echo "$output"
  [ "$status" -eq 0 ]
}

@test "idempotent: a second run leaves MAP.md byte-identical" {
  put PURPOSE.md
  gen
  cp "$R/MAP.md" "$BATS_TEST_TMPDIR/first"
  gen
  cmp "$R/MAP.md" "$BATS_TEST_TMPDIR/first"
}

@test "default root is the parent of scripts/ (a project's mirrored copy works in place)" {
  mkdir -p "$R/scripts"
  cp "$MAP" "$R/scripts/map.py"
  put PURPOSE.md
  run python3 "$R/scripts/map.py"
  [ "$status" -eq 0 ]
  [ -f "$R/MAP.md" ]
  run python3 "$R/scripts/map.py" --check
  [ "$status" -eq 0 ]
}

@test "header and sections come in the order Ontology, Topology, Epistemology" {
  gen
  grep -q 'generated by scripts/map.py' "$R/MAP.md"
  o=$(grep -n '^## Ontology$' "$R/MAP.md" | cut -d: -f1)
  t=$(grep -n '^## Topology$' "$R/MAP.md" | cut -d: -f1)
  e=$(grep -n '^## Epistemology$' "$R/MAP.md" | cut -d: -f1)
  [ -n "$o" ]
  [ -n "$t" ]
  [ -n "$e" ]
  [ "$o" -lt "$t" ]
  [ "$t" -lt "$e" ]
}

@test "locale independent: LC_ALL=C and en_US.UTF-8 give identical bytes" {
  mk_factory
  put PURPOSE.md; put CONTEXT.md
  canon_entry 2 "Zebra"; canon_entry 1 "Älpha"
  LC_ALL=C python3 "$MAP" --root "$R"
  cp "$R/MAP.md" "$BATS_TEST_TMPDIR/c"
  LC_ALL=en_US.UTF-8 python3 "$MAP" --root "$R"
  cmp "$R/MAP.md" "$BATS_TEST_TMPDIR/c"
}

@test "files table: rows appear only for registry files that exist" {
  put PURPOSE.md; put GUARDRAILS.md; mkdir -p "$R/signals"
  gen
  grep -q '^| `PURPOSE.md` |' "$R/MAP.md"
  grep -q '^| `GUARDRAILS.md` |' "$R/MAP.md"
  grep -q '^| `signals/` |' "$R/MAP.md"
  ! grep -q '`CONTEXT.md`' "$R/MAP.md" || false
  grep '^| `GUARDRAILS.md` |' "$R/MAP.md" | grep -q 'before editing, committing or opening a PR'
}

@test "files table: RELATED.md has a row only when the file is present" {
  gen
  ! grep -q 'RELATED.md' "$R/MAP.md" || false
  put RELATED.md
  gen
  grep '^| `RELATED.md` |' "$R/MAP.md" | grep -q 'before building a new capability or adding a dependency'
}

@test "files table: every Read when cell is non-empty, for every registry file at once" {
  for f in PURPOSE.md MAP.md GUARDRAILS.md BEHAVIOUR.md CLAUDE.md CONTEXT.md LEARNINGS.md SPECS.md \
           SKILLS.md RELATED.md .grid/project.yaml; do put "$f"; done
  mkdir -p "$R/openspec" "$R/handoffs" "$R/signals" "$R/knowledge"
  gen
  rows=$(grep -c '^| `' "$R/MAP.md")
  [ "$rows" -ge 15 ]
  # field 4 of "| path | what | read when |" must hold a non-blank value
  empty=$(grep '^| `' "$R/MAP.md" | awk -F'|' '{ gsub(/[ \t]/, "", $4); if ($4 == "") n++ } END { print n+0 }')
  [ "$empty" -eq 0 ]
}

@test "roles: the number of names listed equals the role entries in the real compose configs" {
  mkdir -p "$R/agent-factory/examples"
  cp "$REPO_ROOT"/agent-factory/examples/*.yaml "$R/agent-factory/examples/"
  gen
  want=$(grep -h '^[[:space:]]*- role:' "$R"/agent-factory/examples/*.yaml | wc -l)
  # the Roles block runs from its heading to the next heading of any level
  got=$(awk '/^### Roles$/ {on=1; next} /^#/ {on=0} on' "$R/MAP.md" | grep '^- ' | sed 's/^- [^:]*: //' | tr ',' '\n' | grep -c '[a-z]')
  echo "want=$want got=$got"
  [ "$want" -gt 30 ]
  [ "$got" -eq "$want" ]
}

@test "roles and delegation come from the configs, inline and block lists both" {
  mk_factory
  gen
  grep -q '^- demo: alpha, beta, boss, delta, gamma, lead$' "$R/MAP.md"
  grep -q '^- boss -> alpha, beta$' "$R/MAP.md"
  grep -q '^- lead -> delta, gamma$' "$R/MAP.md"
}

@test "a root with no agent-factory has no Roles or Delegation content and exits 0" {
  put PURPOSE.md
  run gen
  [ "$status" -eq 0 ]
  ! grep -q '### Roles' "$R/MAP.md" || false
  ! grep -q '### Delegation' "$R/MAP.md" || false
}

@test "skills: root-owned and project-local are listed; SKILLS.md is pointed to when present" {
  put skills/aa/SKILL.md; put skills/bb/SKILL.md; put .claude/skills/local-one/SKILL.md
  put SKILLS.md
  gen
  grep -q '^- root-owned: aa, bb$' "$R/MAP.md"
  grep -q '^- project-local (.claude/skills): local-one$' "$R/MAP.md"
  grep -q 'SKILLS.md' "$R/MAP.md"
}

@test "status: empty knowledge gives six zeros, pending signals 0 and no invalid line" {
  mkdir -p "$R/knowledge/canon" "$R/signals"
  put knowledge/README.md; put signals/README.md
  run python3 "$MAP" status --root "$R"
  echo "$output"
  [ "$status" -eq 0 ]
  for s in wip provisional established canonical superseded retired; do
    echo "$output" | grep -qx "$s: 0"
  done
  echo "$output" | grep -qx 'pending signals: 0'
  ! echo "$output" | grep -q 'invalid' || false
}

@test "status counts each stage and names no stage twice" {
  entry wip a; entry wip b; entry provisional c; entry canonical d
  run python3 "$MAP" status --root "$R"
  echo "$output"
  echo "$output" | grep -qx 'wip: 2'
  echo "$output" | grep -qx 'provisional: 1'
  echo "$output" | grep -qx 'canonical: 1'
  echo "$output" | grep -qx 'established: 0'
}

@test "status writes nothing: the tree is byte-identical before and after" {
  put PURPOSE.md; entry wip a; put signals/20260101T000000Z-x-abc123.md
  before=$(cd "$R" && find . -type f -exec cksum {} + | sort)
  run python3 "$MAP" status --root "$R"
  [ "$status" -eq 0 ]
  after=$(cd "$R" && find . -type f -exec cksum {} + | sort)
  [ "$before" = "$after" ]
  [ ! -e "$R/MAP.md" ]
}

@test "status: stage 'maybe' is invalid and in no stage count" {
  mkdir -p "$R/knowledge"
  printf -- '---\nclaim: c\nstage: maybe\n---\n' > "$R/knowledge/m.md"
  run python3 "$MAP" status --root "$R"
  echo "$output"
  echo "$output" | grep -qx 'invalid: 1'
  echo "$output" | grep -qx 'wip: 0'
}

@test "status: a missing stage key is invalid too" {
  mkdir -p "$R/knowledge"
  printf -- '---\nclaim: c\n---\n' > "$R/knowledge/m.md"
  run python3 "$MAP" status --root "$R"
  echo "$output" | grep -qx 'invalid: 1'
}

@test "status: handoffs (names starting with an arrow) and README.md are not pending signals" {
  mkdir -p "$R/signals"
  put signals/README.md; put 'signals/→qa.md'; put signals/20260101T000000Z-x-abc123.md
  run python3 "$MAP" status --root "$R"
  echo "$output"
  echo "$output" | grep -qx 'pending signals: 1'
}

@test "status on an unreadable root exits 2" {
  run python3 "$MAP" status --root "$R/does-not-exist"
  [ "$status" -eq 2 ]
}

@test "status: a non-UTF-8 knowledge file is counted invalid and exits 0" {
  mkdir -p "$R/knowledge/wip"
  printf '\377\376 not utf-8\n' > "$R/knowledge/wip/bad.md"
  run python3 "$MAP" status --root "$R"
  [ "$status" -eq 0 ]
  echo "$output" | grep -qx 'invalid: 1'
}

@test "a read-only root exits 2 with a one-line message, not a traceback" {
  put PURPOSE.md
  chmod 555 "$R"
  run python3 "$MAP" --root "$R"
  chmod 755 "$R"
  [ "$status" -eq 2 ]
  [[ "$output" == "map.py: cannot write "* ]] || false
  [ "$(echo "$output" | wc -l)" -eq 1 ]
}

@test "in a git repo an untracked registry file adds no row, so --check stays 0 (refs #101 VF1)" {
  put PURPOSE.md
  git -C "$R" init -q
  git -C "$R" add PURPOSE.md
  gen
  put .grid/project.yaml
  run python3 "$MAP" --check --root "$R"
  [ "$status" -eq 0 ]
  ! grep -q 'project.yaml' "$R/MAP.md" || false
  # the escape hatch cut-project.sh uses for files that are not committed yet
  run python3 "$MAP" --check --include-untracked --root "$R"
  [ "$status" -eq 1 ]
}

@test "MAP.md holds no volatile data: no stage names with counts, no pending-signal count" {
  entry wip a; entry provisional b; put signals/20260101T000000Z-x-abc123.md
  gen
  ! grep -Eq '(wip|provisional|established|canonical|superseded|retired): [0-9]' "$R/MAP.md" || false
  ! grep -qi 'pending signals: [0-9]' "$R/MAP.md" || false
  grep -q 'python3 scripts/map.py status' "$R/MAP.md"
}

# drift_check — `--check` for MAP.md drift only. These fixtures hold placeholder signals and
# entries that are not valid knowledge files, so the check runs from a lone copy of map.py with
# no knowledge.py beside it: the knowledge lint (tests/test_map_lint.bats) is skipped and only
# the drift result decides.
drift_check() {
  mkdir -p "$BATS_TEST_TMPDIR/solo"
  cp "$MAP" "$BATS_TEST_TMPDIR/solo/map.py"
  run python3 "$BATS_TEST_TMPDIR/solo/map.py" --check --root "$R"
}

@test "--check stays 0 when a signal is added, moved to signals/done, or a wip entry is added" {
  mkdir -p "$R/signals" "$R/knowledge/canon"
  put signals/README.md; put knowledge/README.md; put knowledge/canon/.gitkeep
  gen
  drift_check; [ "$status" -eq 0 ]
  put signals/20260101T000000Z-x-abc123.md
  drift_check; [ "$status" -eq 0 ]
  mkdir -p "$R/signals/done"
  mv "$R/signals/20260101T000000Z-x-abc123.md" "$R/signals/done/"
  drift_check; [ "$status" -eq 0 ]
  entry wip newone
  drift_check; [ "$status" -eq 0 ]
}

@test "--check goes 1 when a canon file is added, until MAP.md is regenerated" {
  mkdir -p "$R/knowledge/canon"
  put knowledge/README.md
  gen
  canon_entry 1 "A fact"
  drift_check
  [ "$status" -eq 1 ]
  gen
  drift_check
  [ "$status" -eq 0 ]
}

@test "canon cap: 23 entries give exactly 20 lines then '+3 more: knowledge/canon/'" {
  for i in $(seq 1 23); do canon_entry "$i" "claim $i"; done
  gen
  [ "$(grep -c '^- .*(knowledge/canon/' "$R/MAP.md")" -eq 20 ]
  grep -qx '+3 more: knowledge/canon/' "$R/MAP.md"
  # sorted by file name: the first is K-001, the twentieth K-020
  grep -q '^- claim 1 (knowledge/canon/K-001-x.md)$' "$R/MAP.md"
  grep -q 'K-020-x.md' "$R/MAP.md"
  ! grep -q 'K-021-x.md' "$R/MAP.md" || false
}

@test "canon: exactly 20 entries add no '+N more' line" {
  for i in $(seq 1 20); do canon_entry "$i" "claim $i"; done
  gen
  ! grep -q 'more: knowledge/canon/' "$R/MAP.md" || false
}

@test "canon: empty knowledge (README and .gitkeep only) lists no canon lines" {
  put knowledge/README.md; put knowledge/canon/.gitkeep
  gen
  [ "$(grep -c '(knowledge/canon/' "$R/MAP.md")" -eq 0 ]
}

@test "canon one-liner: a 200-char claim is cut to its first 140 characters plus '...'" {
  long=$(printf 'abcdefghij%.0s' $(seq 1 20))
  canon_entry 1 "$long"
  gen
  line=$(grep '(knowledge/canon/K-001-x.md)' "$R/MAP.md")
  want="- ${long:0:140}... (knowledge/canon/K-001-x.md)"
  [ "$line" = "$want" ]
}

@test "canon one-liner: whitespace in a claim collapses; a missing claim falls back to the first body line" {
  mkdir -p "$R/knowledge/canon"
  printf -- '---\nclaim:   spaced    out   claim\nstage: canonical\n---\n' > "$R/knowledge/canon/K-001-a.md"
  printf -- '---\nstage: canonical\n---\n\n  first   body line\nsecond\n' > "$R/knowledge/canon/K-002-b.md"
  gen
  grep -qx -- '- spaced out claim (knowledge/canon/K-001-a.md)' "$R/MAP.md"
  grep -qx -- '- first body line (knowledge/canon/K-002-b.md)' "$R/MAP.md"
}

@test "sweep line: 'none configured' by default, named when gh-triage has a Knowledge sweep heading" {
  gen
  grep -q 'none configured' "$R/MAP.md"
  ! grep -q 'gh-triage knowledge sweep' "$R/MAP.md" || false
  mkdir -p "$R/agent-factory/roles/gh-triage"
  printf '# Ops\n\n## Knowledge sweep\n\ntext\n' > "$R/agent-factory/roles/gh-triage/AGENTS.md"
  gen
  grep -q 'gh-triage knowledge sweep' "$R/MAP.md"
  ! grep -q 'none configured' "$R/MAP.md" || false
}

@test "memory statement names what is always in context and what is on demand" {
  gen
  grep -q 'Always in context' "$R/MAP.md"
  grep -q 'On demand' "$R/MAP.md"
}

@test "--check: 0 when current, 1 when stale (prints the regenerate command), 1 when missing" {
  put PURPOSE.md
  run python3 "$MAP" --check --root "$R"
  [ "$status" -eq 1 ]
  [[ "$output" == *"run: python3 scripts/map.py"* ]] || false
  [ ! -e "$R/MAP.md" ]
  gen
  run python3 "$MAP" --check --root "$R"
  [ "$status" -eq 0 ]
  put CONTEXT.md
  run python3 "$MAP" --check --root "$R"
  [ "$status" -eq 1 ]
  [[ "$output" == *"run: python3 scripts/map.py"* ]] || false
}

@test "--check writes nothing" {
  put PURPOSE.md
  gen
  put CONTEXT.md
  before=$(cd "$R" && find . -type f -exec cksum {} + | sort)
  run python3 "$MAP" --check --root "$R"
  after=$(cd "$R" && find . -type f -exec cksum {} + | sort)
  [ "$before" = "$after" ]
}

@test "an unknown flag or argument exits 2 and writes no file" {
  put PURPOSE.md
  run python3 "$MAP" --chek --root "$R"
  [ "$status" -eq 2 ]
  run python3 "$MAP" frobnicate --root "$R"
  [ "$status" -eq 2 ]
  run python3 "$MAP" --root
  [ "$status" -eq 2 ]
  run python3 "$MAP" status --check --root "$R"
  [ "$status" -eq 2 ]
  [ ! -e "$R/MAP.md" ]
}

@test "budget: more than 150 lines exits 2 naming the limit and writes nothing" {
  mkdir -p "$R/agent-factory/examples"
  # 160 orchestrators, one Delegation line each, pushes MAP.md past 150 lines
  for i in $(seq 1 160); do
    printf 'agents:\n  - role: o%03d\n    delegates_to: [x%03d]\n' "$i" "$i" > "$R/agent-factory/examples/p$(printf '%03d' "$i").yaml"
  done
  run gen
  echo "$output"
  [ "$status" -eq 2 ]
  [[ "$output" == *"150"* ]] || false
  [ ! -e "$R/MAP.md" ]
}

@test "budget: an over-budget run leaves an existing MAP.md untouched" {
  put PURPOSE.md
  gen
  cp "$R/MAP.md" "$BATS_TEST_TMPDIR/keep"
  mkdir -p "$R/agent-factory/examples"
  for i in $(seq 1 160); do
    printf 'agents:\n  - role: o%03d\n    delegates_to: [x%03d]\n' "$i" "$i" > "$R/agent-factory/examples/p$(printf '%03d' "$i").yaml"
  done
  run gen
  [ "$status" -eq 2 ]
  cmp "$R/MAP.md" "$BATS_TEST_TMPDIR/keep"
  # --check reports the same limit as an error, not as drift
  run python3 "$MAP" --check --root "$R"
  [ "$status" -eq 2 ]
}

@test "budget: more than 12000 bytes exits 2 naming the limit" {
  # one very long skills line: 700 skills x 20 chars
  for i in $(seq 1 700); do mkdir -p "$R/skills/skill-name-padding-$(printf '%04d' "$i")"; : > "$R/skills/skill-name-padding-$(printf '%04d' "$i")/SKILL.md"; done
  run gen
  echo "$output"
  [ "$status" -eq 2 ]
  [[ "$output" == *"12000"* ]] || false
  [ ! -e "$R/MAP.md" ]
}

@test "the real repo: MAP.md is within budget when generated from a copy of its inputs" {
  # Copy only what map.py reads, so this never writes into the repo.
  mkdir -p "$R/agent-factory/examples" "$R/agent-factory/roles"
  cp "$REPO_ROOT"/agent-factory/examples/*.yaml "$R/agent-factory/examples/"
  cp -R "$REPO_ROOT/skills" "$R/skills"
  for f in PURPOSE.md GUARDRAILS.md BEHAVIOUR.md CLAUDE.md CONTEXT.md LEARNINGS.md SPECS.md SKILLS.md; do
    [ -e "$REPO_ROOT/$f" ] && cp "$REPO_ROOT/$f" "$R/$f"
  done
  gen
  [ "$(wc -l < "$R/MAP.md")" -le 150 ]
  [ "$(wc -c < "$R/MAP.md")" -le 12000 ]
}
