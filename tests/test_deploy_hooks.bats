#!/usr/bin/env bats
# Tests for agent-factory/deploy_hooks.py (the project hook emitter) and its
# compatibility with deploy.py and the project-factory skeleton.
#
# Scenarios come from openspec/changes/hook-profiles/specs/hook-profiles/spec.md
# (Profile resolution, Non-clobbering merge, Idempotent/checkable/cost-disclosed
# emission, and the launcher scenarios that need an emitted file). The two
# catalogue-agreement scenarios live in tests/test_hooks.bats.
#
# Needs the agent-factory venv (project mode reads project.yaml with PyYAML); skipped
# where it is not built. Every test works in temp dirs against a fixture grid
# (GRID_DIR) with its own tiny hooks/catalogue.json, except the end-to-end and
# --list-real tests, which use the real repo's hooks/.
#
# These are the author's own checks; independent verification belongs to qa-engineer.

bats_require_minimum_version 1.5.0   # `run -127` below

load helpers/setup
load helpers/portable
load helpers/hooks
load helpers/venv

setup() {
  common_setup
  # A temp HOME (set AFTER common_setup, which captured REAL_HOME for the sandbox check).
  export HOME="$MOCK_HOOK_ROOT/home"
  mkdir -p "$HOME"
  PY="$REPO_ROOT/agent-factory/.venv/bin/python"
  require_venv "$PY"
  EMIT="$REPO_ROOT/agent-factory/deploy_hooks.py"
  PROJ="$MOCK_HOOK_ROOT/proj"
  mkdir -p "$PROJ"
  L="$PROJ/.claude/settings.local.json"   # target: local (default)
  S="$PROJ/.claude/settings.json"         # target: shared
  FIXTURE="$REPO_ROOT/tests/fixtures/hooks/settings-handwritten.json"

  # Fixture grid: two project hooks (different profiles and timeouts) and one user hook.
  # The emitter only reads the catalogue, so no scripts are needed here.
  FGRID="$MOCK_HOOK_ROOT/grid"
  mkdir -p "$FGRID/hooks"
  cat > "$FGRID/hooks/catalogue.json" <<'EOF'
{
  "version": 1,
  "hooks": [
    { "id": "guard-min", "scope": "project", "event": "PreToolUse", "matcher": "Bash",
      "min_profile": "minimal", "fail": "closed", "timeout": 5, "model_cost": false,
      "on_failure": "block",
      "cost": "0 tokens (fixture minimal guard).", "description": "fixture" },
    { "id": "guard-std", "scope": "project", "event": "PreToolUse", "matcher": "Bash",
      "min_profile": "standard", "fail": "closed", "timeout": 7, "model_cost": false,
      "cost": "0 tokens (fixture standard guard).", "description": "fixture" },
    { "id": "user-job", "scope": "user", "event": "SessionEnd",
      "fail": "open", "timeout": 5, "model_cost": true,
      "cost": "One model run per session (fixture).", "description": "fixture" }
  ]
}
EOF
  # --user refuses a GRID_DIR without a launcher (WP-015), so the fixture grid has an empty one;
  # nothing here runs it except the end-to-end tests, which use the real hooks/.
  : > "$FGRID/hooks/run.sh"
  export GRID_DIR="$FGRID"
}

teardown() {
  common_teardown
}

# ---------------------------------------------------------------------------
# helpers local to this file
# ---------------------------------------------------------------------------

# emit [args...]: run the emitter on $PROJ (status/output via bats `run`).
emit() { run "$PY" "$EMIT" "$PROJ" "$@"; }

# set_profile <profile> [target]: write the hooks: block of $PROJ/.grid/project.yaml.
set_profile() {
  mkdir -p "$PROJ/.grid"
  printf 'hooks:\n  profile: %s\n' "$1" > "$PROJ/.grid/project.yaml"
  if [ -n "${2:-}" ]; then printf '  target: %s\n' "$2" >> "$PROJ/.grid/project.yaml"; fi
}

# owned_ids <settings file>: sorted, comma-joined ids of every generated handler in it
# (empty when none). The id is the third space-separated word of the command.
owned_ids() {
  jq -r '[.. | objects | .command? | strings | select(contains("GENERATED by the-grid deploy_hooks.py")) | split(" ")[2]] | sort | join(",")' "$1"
}

# use_fixture <file>: start from the hand-written settings fixture.
use_fixture() {
  mkdir -p "$(dirname "$1")"
  cp "$FIXTURE" "$1"
}

# ---------------------------------------------------------------------------
# Profile resolution
# ---------------------------------------------------------------------------

@test "absent hooks key means off: no settings file is written" {
  # No project.yaml at all, then one with other keys but no hooks: key.
  emit
  [ "$status" -eq 0 ]
  [ ! -e "$PROJ/.claude" ]
  mkdir -p "$PROJ/.grid"
  printf 'context: |\n  some fact\n' > "$PROJ/.grid/project.yaml"
  emit
  [ "$status" -eq 0 ]
  [[ "$output" == *"profile=off"* ]] || false
  [ ! -e "$PROJ/.claude" ]
}

@test "--profile overrides the file" {
  set_profile minimal
  emit --profile strict
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "guard-min,guard-std" ]
}

@test "the file's profile is used when no flag is given" {
  set_profile minimal
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "guard-min" ]
}

@test "an unknown profile is rejected, names the allowed values and writes nothing" {
  set_profile paranoid
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"off, minimal, standard, strict"* ]] || false
  [ ! -e "$PROJ/.claude" ]
}

@test "standard includes minimal" {
  set_profile standard
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "guard-min,guard-std" ]
}

@test "strict equals standard (same bytes)" {
  set_profile standard
  emit
  cp "$L" "$MOCK_HOOK_ROOT/standard.json"
  rm -rf "$PROJ/.claude"
  set_profile strict
  emit
  [ "$status" -eq 0 ]
  cmp "$L" "$MOCK_HOOK_ROOT/standard.json"
}

@test "an unknown key under hooks: is rejected, names the allowed keys and writes nothing" {
  mkdir -p "$PROJ/.grid"
  printf 'hooks:\n  enable: [guard-std]\n' > "$PROJ/.grid/project.yaml"
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"enable"* ]] || false
  [[ "$output" == *"profile, target"* ]] || false
  [ ! -e "$PROJ/.claude" ]
}

@test "an unknown target is rejected and writes nothing" {
  set_profile minimal bogus
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"local, shared"* ]] || false
  [ ! -e "$PROJ/.claude" ]
}

@test "user-scope hooks never reach a project file" {
  set_profile strict
  emit
  [ "$status" -eq 0 ]
  [ -f "$L" ]
  ! grep -q 'SessionEnd' "$L" || false
  ! grep -q 'user-job' "$L" || false
  rm -rf "$PROJ/.claude"
  emit --target shared
  [ "$status" -eq 0 ]
  [ -f "$S" ]
  ! grep -q 'SessionEnd' "$S" || false
  ! grep -q 'user-job' "$S" || false
}

@test "deploy.py tolerates a hooks: mapping in project.yaml" {
  mkdir -p "$PROJ/.grid"
  printf 'hooks:\n  profile: standard\n  target: shared\n' > "$PROJ/.grid/project.yaml"
  run "$PY" "$REPO_ROOT/agent-factory/deploy.py" "$PROJ" --roles qa-engineer
  [ "$status" -eq 0 ]
  [[ "$output" != *"unknown key"* ]] || false
  [ -f "$PROJ/.claude/agents/grid-qa-engineer.md" ]
}

@test "deploy.py still rejects a genuinely unknown project.yaml key" {
  mkdir -p "$PROJ/.grid"
  printf 'bogus: 1\n' > "$PROJ/.grid/project.yaml"
  run "$PY" "$REPO_ROOT/agent-factory/deploy.py" "$PROJ" --roles qa-engineer
  [ "$status" -eq 1 ]
  [[ "$output" == *"unknown key"*"hooks"* ]] || false
}

@test "the project-factory skeleton project.yaml resolves to off" {
  mkdir -p "$PROJ/.grid"
  cp "$REPO_ROOT/project-factory/templates/_common/.grid/project.yaml" "$PROJ/.grid/project.yaml"
  emit
  [ "$status" -eq 0 ]
  [[ "$output" == *"profile=off"* ]] || false
  [ ! -e "$PROJ/.claude" ]
}

@test "target: local is the default; target: shared writes settings.json; --target overrides" {
  set_profile minimal
  emit
  [ -f "$L" ]
  [ ! -e "$S" ]
  rm -rf "$PROJ/.claude"
  set_profile minimal shared
  emit
  [ -f "$S" ]
  [ ! -e "$L" ]
  rm -rf "$PROJ/.claude"
  emit --target local
  [ -f "$L" ] && [ ! -e "$S" ]
}

@test "an explicit 'profile: off' (a YAML boolean) is read as the word off" {
  set_profile standard
  emit
  [ "$(owned_ids "$L")" = "guard-min,guard-std" ]
  set_profile off
  emit
  [ "$status" -eq 0 ]
  [[ "$output" == *"profile=off"* ]] || false
  [ "$(owned_ids "$L")" = "" ]
}

@test "emitted handlers carry the catalogue event, matcher and timeout" {
  set_profile standard
  emit
  [ "$(jq -r '.hooks.PreToolUse[0].matcher' "$L")" = "Bash" ]
  [ "$(jq -r '.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-min")) | .timeout' "$L")" = "5" ]
  [ "$(jq -r '.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-std")) | .timeout' "$L")" = "7" ]
}

@test "emitted guard entries carry onFailure block; an entry without on_failure does not" {
  set_profile standard
  emit
  [ "$status" -eq 0 ]
  # guard-min has on_failure: block in the catalogue; guard-std (also fail: closed) has none
  [ "$(jq -r '.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-min")) | .onFailure' "$L")" = "block" ]
  [ "$(jq -r '.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-std")) | has("onFailure")' "$L")" = "false" ]
}

@test "--check reports a missing onFailure, and a re-emit restores it" {
  set_profile standard
  emit
  jq 'del(.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-min")) | .onFailure)' "$L" > "$MOCK_HOOK_ROOT/edited.json"
  mv "$MOCK_HOOK_ROOT/edited.json" "$L"
  emit --check
  [ "$status" -eq 1 ]
  [[ "$output" == *"stale"*"guard-min"*"onFailure"* ]] || false
  emit
  [ "$status" -eq 0 ]
  [ "$(jq -r '.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-min")) | .onFailure' "$L")" = "block" ]
  emit --check
  [ "$status" -eq 0 ]
}

@test "a catalogue on_failure other than block is rejected" {
  jq '(.hooks[0].on_failure) = "explode"' "$FGRID/hooks/catalogue.json" > "$MOCK_HOOK_ROOT/c.json"
  mv "$MOCK_HOOK_ROOT/c.json" "$FGRID/hooks/catalogue.json"
  set_profile standard
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"on_failure"* ]] || false
  [ ! -e "$L" ]
}

@test "the real catalogue gives both guards on_failure block and no other hook" {
  run jq -e '[.hooks[] | select(.on_failure == "block") | .id] | sort == ["pre-bash-no-bypass", "pre-bash-secret-scan"]' "$REPO_ROOT/hooks/catalogue.json"
  [ "$status" -eq 0 ]
}

# ---------------------------------------------------------------------------
# Portable launcher: what the emitted command looks like and does
# ---------------------------------------------------------------------------

@test "no absolute paths: the settings file holds no home path" {
  set_profile strict
  emit
  [ "$status" -eq 0 ]
  # The command keeps the LITERAL text ${GRID_DIR:-$HOME/.the-grid} (the shell expands it
  # when the hook runs); what must be absent is the expanded temp HOME and any home dir.
  ! grep -qF "$HOME" "$L" || false
  ! grep -qF '/Users/' "$L" || false
  ! grep -qF '/home/' "$L" || false
  grep -qF '${GRID_DIR:-$HOME/.the-grid}/hooks/run.sh' "$L"
}

@test "the emitted command runs end to end against the real hooks (blocks --no-verify, exit 2)" {
  export GRID_DIR="$REPO_ROOT"
  set_profile minimal
  emit
  [ "$status" -eq 0 ]
  cmd="$(jq -r '.hooks.PreToolUse[0].hooks[0].command' "$L")"
  hook_payload "git commit --no-verify -m x" > "$MOCK_HOOK_ROOT/payload.json"
  run bash -c "$cmd" < "$MOCK_HOOK_ROOT/payload.json"
  [ "$status" -eq 2 ]
  # ...and lets a harmless command through.
  hook_payload "ls -la" > "$MOCK_HOOK_ROOT/payload.json"
  run bash -c "$cmd" < "$MOCK_HOOK_ROOT/payload.json"
  [ "$status" -eq 0 ]
}

@test "a missing grid is a visible error: the emitted command exits 127" {
  set_profile minimal
  emit
  [ "$status" -eq 0 ]
  cmd="$(jq -r '.hooks.PreToolUse[0].hooks[0].command' "$L")"
  mkdir -p "$MOCK_HOOK_ROOT/emptyhome"
  run -127 env -u GRID_DIR HOME="$MOCK_HOOK_ROOT/emptyhome" bash -c "$cmd"
}

# ---------------------------------------------------------------------------
# Non-clobbering merge
# ---------------------------------------------------------------------------

@test "hand-written hooks and unrelated keys survive, in the same order" {
  use_fixture "$L"
  set_profile standard
  emit
  [ "$status" -eq 0 ]
  # Top-level key order is unchanged.
  [ "$(jq -c 'keys_unsorted' "$L")" = "$(jq -c 'keys_unsorted' "$FIXTURE")" ]
  # Unrelated keys and the hand-written entries are identical, compared compact.
  for path in .permissions .env .model .hooks.SessionEnd '.hooks.PreToolUse[0].matcher' '.hooks.PreToolUse[0].hooks[0]'; do
    [ "$(jq -c "$path" "$L")" = "$(jq -c "$path" "$FIXTURE")" ]
  done
  # Ours were appended after the hand-written handler, in the existing Bash entry.
  [ "$(jq '.hooks.PreToolUse | length' "$L")" -eq 1 ]
  [ "$(jq '.hooks.PreToolUse[0].hooks | length' "$L")" -eq 3 ]
  [ "$(owned_ids "$L")" = "guard-min,guard-std" ]
}

@test "output keeps 2-space indent and a trailing newline" {
  use_fixture "$L"
  set_profile minimal
  emit
  grep -q '^  "permissions": {' "$L"
  [ "$(tail -c1 "$L" | od -An -c | tr -d ' ')" = '\n' ]
}

@test "lowering the profile removes only the generated entry that is no longer wanted" {
  use_fixture "$L"
  set_profile standard
  emit
  set_profile minimal
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "guard-min" ]
  [ "$(jq -c '.hooks.PreToolUse[0].hooks[0]' "$L")" = "$(jq -c '.hooks.PreToolUse[0].hooks[0]' "$FIXTURE")" ]
  [ "$(jq -c '.hooks.SessionEnd' "$L")" = "$(jq -c '.hooks.SessionEnd' "$FIXTURE")" ]
}

@test "off removes every generated entry from both files and leaves the rest byte-identical" {
  use_fixture "$L"
  set_profile standard
  emit
  cp "$L" "$S"                       # generated entries now live in both files
  jq 'del(.permissions, .env, .model)' "$S" > "$MOCK_HOOK_ROOT/s.json"
  mv "$MOCK_HOOK_ROOT/s.json" "$S"
  set_profile off
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "" ]
  [ "$(owned_ids "$S")" = "" ]
  cmp "$L" "$FIXTURE"                # add-then-remove restores the original bytes
  jq -e '.hooks.SessionEnd' "$S" >/dev/null   # S's hand-written hooks are still there
}

@test "off on a file that only held generated entries leaves an empty object, not a deleted file" {
  set_profile minimal
  emit
  [ -f "$L" ]
  set_profile off
  emit
  [ "$status" -eq 0 ]
  [ "$(jq -c . "$L")" = "{}" ]
}

@test "invalid JSON is not overwritten and nothing else is written" {
  mkdir -p "$PROJ/.claude"
  printf '{ not json,' > "$L"
  cp "$L" "$MOCK_HOOK_ROOT/before"
  set_profile standard
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"settings.local.json"* ]] || false
  cmp "$L" "$MOCK_HOOK_ROOT/before"
  [ ! -e "$S" ]
}

@test "invalid JSON in the file that is NOT the target also aborts before any write" {
  mkdir -p "$PROJ/.claude"
  printf '{ not json,' > "$S"
  set_profile standard                # target local: S is only swept, but must still parse
  emit
  [ "$status" -ne 0 ]
  [ ! -e "$L" ]
}

@test "a settings file that is valid JSON but not an object is refused" {
  mkdir -p "$PROJ/.claude"
  printf '[]\n' > "$L"
  set_profile standard
  emit
  [ "$status" -ne 0 ]
  [ "$(cat "$L")" = "[]" ]
}

@test "a hooks value of the wrong type is refused rather than overwritten" {
  mkdir -p "$PROJ/.claude"
  printf '{"hooks": []}\n' > "$L"
  set_profile standard
  emit
  [ "$status" -ne 0 ]
  [ "$(cat "$L")" = '{"hooks": []}' ]
}

@test "changing target moves the entries instead of duplicating them" {
  use_fixture "$L"
  set_profile standard
  emit
  set_profile standard shared
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$S")" = "guard-min,guard-std" ]
  [ "$(owned_ids "$L")" = "" ]
  cmp "$L" "$FIXTURE"                # the local file is back to its hand-written bytes
}

@test "only commands of the exact generated shape are owned" {
  # A path-lookalike without the marker, and a marker on some other command: both are
  # hand-written as far as the emitter can tell, so even `off` leaves them alone.
  mkdir -p "$PROJ/.claude"
  jq -n --arg a 'bash "/x/hooks/run.sh" guard-min' --arg b 'echo hi # GENERATED by the-grid deploy_hooks.py' \
    '{hooks: {PreToolUse: [{matcher: "Bash", hooks: [{type: "command", command: $a}, {type: "command", command: $b}]}]}}' > "$L"
  cp "$L" "$MOCK_HOOK_ROOT/before"
  set_profile off
  emit
  [ "$status" -eq 0 ]
  cmp "$L" "$MOCK_HOOK_ROOT/before"
}

# The ownership pattern is anchored at the START: a command that merely CONTAINS the generated
# shape after other commands is not ours, so `off` must not rewrite or remove it (R16.qa.F9).
@test "a command that only ends in the generated shape is not owned" {
  mkdir -p "$PROJ/.claude"
  jq -n --arg a 'echo x; bash "/x/hooks/run.sh" guard-min # GENERATED by the-grid deploy_hooks.py' \
    '{hooks: {PreToolUse: [{matcher: "Bash", hooks: [{type: "command", command: $a}]}]}}' > "$L"
  cp "$L" "$MOCK_HOOK_ROOT/before"
  set_profile off
  emit
  [ "$status" -eq 0 ]
  cmp "$L" "$MOCK_HOOK_ROOT/before"
}

# atomic_write goes through a mkstemp file (mode 0600) and renames it over the target, so the
# existing file's mode has to be copied across explicitly (R16.qa.F9).
@test "an existing settings file keeps its mode when the emitter rewrites it" {
  use_fixture "$L"
  chmod 640 "$L"
  set_profile minimal
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "guard-min" ]       # it really was rewritten
  [ "$(ls -l "$L" | cut -c1-10)" = "-rw-r-----" ]
}

@test "a generated entry with a different launcher path is replaced by the portable form" {
  mkdir -p "$PROJ/.claude"
  jq -n --arg a 'bash "/old/place/hooks/run.sh" guard-min # GENERATED by the-grid deploy_hooks.py' \
    '{hooks: {PreToolUse: [{matcher: "Bash", hooks: [{type: "command", timeout: 5, command: $a}]}]}}' > "$L"
  set_profile minimal
  emit
  [ "$status" -eq 0 ]
  ! grep -q '/old/place' "$L" || false
  [ "$(owned_ids "$L")" = "guard-min" ]
  [ "$(jq '.hooks.PreToolUse[0].hooks | length' "$L")" -eq 1 ]
}

@test "refuses a symlinked .claude directory and writes nothing through it" {
  mkdir -p "$MOCK_HOOK_ROOT/elsewhere"
  ln -s "$MOCK_HOOK_ROOT/elsewhere" "$PROJ/.claude"
  set_profile standard
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"symlink"* ]] || false
  [ -z "$(ls -A "$MOCK_HOOK_ROOT/elsewhere")" ]
}

@test "refuses a symlinked settings file and leaves its target untouched" {
  mkdir -p "$PROJ/.claude"
  printf '{}\n' > "$MOCK_HOOK_ROOT/real.json"
  ln -s "$MOCK_HOOK_ROOT/real.json" "$L"
  set_profile standard
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"symlink"* ]] || false
  [ "$(cat "$MOCK_HOOK_ROOT/real.json")" = "{}" ]
}

# ---------------------------------------------------------------------------
# merge_owned() itself: the cases project mode cannot reach (matcher-less events,
# which only user-scope hooks use), plus the pruning rule
# ---------------------------------------------------------------------------

@test "merge_owned: matcher-less events, idempotence, removal and pruning only what removal emptied" {
  export PYTHONDONTWRITEBYTECODE=1    # importing the module must not leave __pycache__ in the repo
  run "$PY" - "$REPO_ROOT/agent-factory" "$FIXTURE" <<'PYEOF'
import json, sys
sys.path.insert(0, sys.argv[1])
import deploy_hooks as d

fixture = json.load(open(sys.argv[2]))
cmd = 'bash "${GRID_DIR:-$HOME/.the-grid}/hooks/run.sh" user-job # GENERATED by the-grid deploy_hooks.py'
want = [("SessionEnd", None, cmd, 5, None)]   # (event, matcher, command, timeout, on_failure)

# Added to the existing matcher-less entry, after the hand-written handler.
once = d.merge_owned(fixture, want)
assert len(once["hooks"]["SessionEnd"]) == 1, once
assert [h["command"] for h in once["hooks"]["SessionEnd"][0]["hooks"]][1] == cmd
# Idempotent, and the input was not mutated.
assert d.merge_owned(once, want) == once
assert "timeout" not in fixture["hooks"]["SessionEnd"][0]["hooks"][0]
# Removing it restores the original exactly (and the key order).
back = d.merge_owned(once, [])
assert back == fixture and list(back) == list(fixture)

# A brand-new matcher-less event gets an entry with no "matcher" key.
fresh = d.merge_owned({}, want)
assert fresh == {"hooks": {"SessionEnd": [{"hooks": [{"type": "command", "timeout": 5, "command": cmd}]}]}}, fresh
# Removal prunes the entry, the event and "hooks" because removal emptied all three.
assert d.merge_owned(fresh, []) == {}

# An empty container the user left behind is NOT ours to prune.
odd = {"hooks": {"Stop": [], "SessionEnd": [{"hooks": [{"type": "command", "timeout": 5, "command": cmd}]}]}}
assert d.merge_owned(odd, []) == {"hooks": {"Stop": []}}

# Wrong-typed container we must add into is an error, not a silent overwrite.
try:
    d.merge_owned({"hooks": {"SessionEnd": {}}}, want)
except d.SettingsError:
    pass
else:
    raise AssertionError("expected SettingsError")
print("ok")
PYEOF
  [ "$status" -eq 0 ]
  [[ "$output" == *"ok"* ]] || false
}

# ---------------------------------------------------------------------------
# Idempotent, checkable and cost-disclosed emission
# ---------------------------------------------------------------------------

@test "a second run is a no-op: nothing written, file not touched" {
  use_fixture "$L"
  set_profile standard
  emit
  [ "$status" -eq 0 ]
  cp "$L" "$MOCK_HOOK_ROOT/after-first"
  # Age the settings file and a reference file to the same old time; if the second run
  # rewrote the file it would be newer than the reference (no stat flags: BSD and GNU).
  ref="$MOCK_HOOK_ROOT/ref"
  : > "$ref"
  touch -t 200001010000 "$L" "$ref"
  emit
  [ "$status" -eq 0 ]
  [[ "$output" == *"0 written"* ]] || false
  [ ! "$L" -nt "$ref" ]
  cmp "$L" "$MOCK_HOOK_ROOT/after-first"
}

@test "--check passes on a project that matches, and on one that never opted in" {
  emit --check
  [ "$status" -eq 0 ]
  set_profile standard
  emit
  emit --check
  [ "$status" -eq 0 ]
}

@test "--check reports a hand-deleted entry by id, exits 1 and writes nothing" {
  use_fixture "$L"
  set_profile standard
  emit
  jq 'del(.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-std")))' "$L" > "$MOCK_HOOK_ROOT/edited.json"
  mv "$MOCK_HOOK_ROOT/edited.json" "$L"
  cp "$L" "$MOCK_HOOK_ROOT/before"
  emit --check
  [ "$status" -eq 1 ]
  [[ "$output" == *"guard-std"* ]] || false
  [[ "$output" != *"guard-min"* ]] || false
  cmp "$L" "$MOCK_HOOK_ROOT/before"
}

@test "--check reports an entry that should be gone, and a stale timeout" {
  set_profile standard
  emit
  emit --check --profile minimal
  [ "$status" -eq 1 ]
  [[ "$output" == *"remove"*"guard-std"* ]] || false
  jq '(.hooks.PreToolUse[0].hooks[] | select(.command | contains("guard-min")) | .timeout) = 99' "$L" > "$MOCK_HOOK_ROOT/edited.json"
  mv "$MOCK_HOOK_ROOT/edited.json" "$L"
  emit --check
  [ "$status" -eq 1 ]
  [[ "$output" == *"stale"*"guard-min"* ]] || false
}

@test "--check on a project that opted in but was never emitted names every missing hook" {
  set_profile standard
  emit --check
  [ "$status" -eq 1 ]
  [[ "$output" == *"guard-min"* ]] || false
  [[ "$output" == *"guard-std"* ]] || false
  [ ! -e "$PROJ/.claude" ]
}

@test "--dry-run shows the plan and writes nothing" {
  set_profile standard
  emit --dry-run
  [ "$status" -eq 0 ]
  [[ "$output" == *"guard-min"* ]] || false
  [[ "$output" == *"guard-std"* ]] || false
  [ ! -e "$PROJ/.claude" ]
}

@test "--list prints scope, minimum profile, cost and model use for every hook" {
  run "$PY" "$EMIT" --list
  [ "$status" -eq 0 ]
  # Project hook: scope, min profile, cost, model_cost no.
  line="$(grep '^guard-std' <<<"$output")"
  [[ "$line" == *project*standard*no*"fixture standard guard"* ]] || false
  # User hook: scope user, no min profile ("-"), model_cost yes.
  line="$(grep '^user-job' <<<"$output")"
  [[ "$line" == *user*"-"*yes*"One model run per session"* ]] || false
}

@test "--list against the real catalogue exits 0 and shows every real id" {
  export GRID_DIR="$REPO_ROOT"
  run "$PY" "$EMIT" --list
  [ "$status" -eq 0 ]
  local seen=0
  while IFS= read -r id; do
    seen=$((seen + 1))
    [[ "$output" == *"$id"* ]] || { echo "missing from --list: $id" >&2; false; }
  done < <(jq -r '.hooks[].id' "$REPO_ROOT/hooks/catalogue.json")
  # A loop over zero ids passes: an empty or unreadable catalogue must fail here.
  [ "$seen" -gt 0 ]
}

@test "--list needs no project, and a missing catalogue is a clear error" {
  run "$PY" "$EMIT" --list
  [ "$status" -eq 0 ]
  run env GRID_DIR="$MOCK_HOOK_ROOT/nowhere" "$PY" "$EMIT" --list
  [ "$status" -ne 0 ]
  [[ "$output" == *"catalogue not found"* ]] || false
}

# ---------------------------------------------------------------------------
# WP-014: settings writer convergence, scope, input hygiene, write semantics
# (hardening, refs private WP-014)
# ---------------------------------------------------------------------------

# emit_user [args...]: the machine-level run for the fixture's one user hook.
emit_user() { run "$PY" "$EMIT" --user --hooks user-job "$@"; }

# user_file: the user settings file the --user runs touch (CLAUDE_CONFIG_DIR is a temp dir).
user_file() { printf '%s\n' "$CLAUDE_CONFIG_DIR/settings.json"; }

# user_cmd: the command a --user run writes for the fixture grid (absolute grid path).
user_cmd() { printf 'bash "%s/hooks/run.sh" user-job # GENERATED by the-grid deploy_hooks.py' "$FGRID"; }

@test "hand-written matcher-less SessionEnd entry before the generated one converges in one run" {
  U="$(user_file)"; mkdir -p "$CLAUDE_CONFIG_DIR"
  jq -n --arg c "$(user_cmd)" \
    '{hooks: {SessionEnd: [{hooks: [{type: "command", command: "echo mine"}]}, {hooks: [{type: "command", timeout: 5, command: $c}]}]}}' > "$U"
  emit_user
  [ "$status" -eq 0 ]
  [[ "$output" == *"0 written"* ]]                      # already converged: nothing to do
  [ "$(owned_ids "$U")" = "user-job" ]                  # exactly one generated handler
  emit_user --check
  [ "$status" -eq 0 ]
}

# CLAUDE_CONFIG_DIR pointed at the project's .claude makes the user file and the project's
# shared file the SAME file; each mode must then leave the other scope's handlers alone.
@test "project then user run on one file keeps both sets" {
  export CLAUDE_CONFIG_DIR="$PROJ/.claude"
  set_profile standard shared
  emit
  [ "$status" -eq 0 ]
  emit_user
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$S")" = "guard-min,guard-std,user-job" ]
  emit                                  # and the project run again does not eat the user hook
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$S")" = "guard-min,guard-std,user-job" ]
}

@test "user then project run on one file keeps both sets" {
  export CLAUDE_CONFIG_DIR="$PROJ/.claude"
  set_profile standard shared
  emit_user
  [ "$status" -eq 0 ]
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$S")" = "guard-min,guard-std,user-job" ]
  emit_user                             # and the user run again does not eat the guards
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$S")" = "guard-min,guard-std,user-job" ]
  # --check agrees in both modes (neither sees the other's handlers as drift).
  emit --check
  [ "$status" -eq 0 ]
  emit_user --check
  [ "$status" -eq 0 ]
}

@test "an owned id the catalogue does not know is still swept (a retired hook goes away)" {
  U="$(user_file)"; mkdir -p "$CLAUDE_CONFIG_DIR"
  jq -n '{hooks: {SessionEnd: [{hooks: [{type: "command", timeout: 5, command: "bash \"/old/hooks/run.sh\" retired-hook # GENERATED by the-grid deploy_hooks.py"}]}]}}' > "$U"
  emit_user
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$U")" = "user-job" ]
}

# ---- input hygiene: inputs the writer cannot rewrite safely are refused, unchanged ----

# A settings file the run would have to CHANGE (it lacks the generated handler), so a
# refusal is observable as "file still has exactly these bytes".
seed_user_file() {
  mkdir -p "$CLAUDE_CONFIG_DIR"
  printf '%s\n' "$1" > "$(user_file)"
  cp "$(user_file)" "$MOCK_HOOK_ROOT/before"
}

@test "a read-only (0444) settings file is refused and unchanged" {
  seed_user_file '{"theme": "dark"}'
  chmod 444 "$(user_file)"
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"read-only"* ]] || false
  [[ "$output" != *"Traceback"* ]] || false
  cmp "$(user_file)" "$MOCK_HOOK_ROOT/before"
}

@test "a read-only settings file that already matches is not an error (--check and a re-run pass)" {
  emit_user
  [ "$status" -eq 0 ]
  chmod 444 "$(user_file)"
  emit_user
  [ "$status" -eq 0 ]
  emit_user --check
  [ "$status" -eq 0 ]
}

@test "numbers that are not finite are refused (1e999, NaN, Infinity) and the file is unchanged" {
  for body in '{"x": 1e999}' '{"x": NaN}' '{"x": Infinity}' '{"x": -Infinity}'; do
    seed_user_file "$body"
    emit_user
    [ "$status" -ne 0 ]
    [[ "$output" == *"nothing was written"* ]] || false
    [[ "$output" != *"Traceback"* ]] || false
    cmp "$(user_file)" "$MOCK_HOOK_ROOT/before"
  done
}

@test "duplicate keys are refused (a rewrite would silently drop one) and the file is unchanged" {
  seed_user_file '{"a": 1, "a": 2}'
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"duplicate"* ]] || false
  cmp "$(user_file)" "$MOCK_HOOK_ROOT/before"
}

@test "a directory as the settings file is refused with a one-line error, no traceback" {
  mkdir -p "$CLAUDE_CONFIG_DIR/settings.json"
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"not a regular file"* ]] || false
  [[ "$output" != *"Traceback"* ]] || false
  [ -d "$CLAUDE_CONFIG_DIR/settings.json" ]
}

@test "a FIFO as the settings file is refused and left in place" {
  mkdir -p "$CLAUDE_CONFIG_DIR"
  mkfifo "$CLAUDE_CONFIG_DIR/settings.json"
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"not a regular file"* ]] || false
  [ -p "$CLAUDE_CONFIG_DIR/settings.json" ]
}

@test "a lone surrogate in a string is a clean error, not a traceback, and nothing is written" {
  seed_user_file '{"s": "\ud800"}'
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"nothing was written"* ]] || false
  [[ "$output" != *"Traceback"* ]] || false
  cmp "$(user_file)" "$MOCK_HOOK_ROOT/before"
}

@test "an unwritable config dir is a clean error, not a traceback" {
  [ "$(id -u)" -ne 0 ] || skip "root ignores directory permissions"
  mkdir -p "$CLAUDE_CONFIG_DIR"
  chmod 555 "$CLAUDE_CONFIG_DIR"
  emit_user
  chmod 755 "$CLAUDE_CONFIG_DIR"
  [ "$status" -ne 0 ]
  [[ "$output" == *"nothing was written"* ]] || false
  [[ "$output" != *"Traceback"* ]] || false
  [ ! -e "$(user_file)" ]
}

@test "an empty or whitespace-only settings file is refused and the message names the fix" {
  for body in '' '
'; do
    mkdir -p "$CLAUDE_CONFIG_DIR"
    printf '%s' "$body" > "$(user_file)"
    cp "$(user_file)" "$MOCK_HOOK_ROOT/before"
    emit_user
    [ "$status" -ne 0 ]
    [[ "$output" == *"is empty"* ]] || false
    [[ "$output" == *"write {}"* ]] || false
    cmp "$(user_file)" "$MOCK_HOOK_ROOT/before"
  done
}

@test "project mode refuses a 0444 settings file the same way" {
  mkdir -p "$PROJ/.claude"
  printf '{"theme": "dark"}\n' > "$L"
  chmod 444 "$L"
  cp "$L" "$MOCK_HOOK_ROOT/before"
  set_profile minimal
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"read-only"* ]] || false
  cmp "$L" "$MOCK_HOOK_ROOT/before"
}

# ---- write semantics: umask for new files, no clobbering of a concurrent edit ----

@test "a new settings file honours umask 077 (mode 600)" {
  run bash -c 'umask 077; exec "$0" "$1" --user --hooks user-job' "$PY" "$EMIT"
  [ "$status" -eq 0 ]
  [ "$(file_mode "$(user_file)")" = "600" ]
}

@test "a new settings file under umask 022 is mode 644" {
  run bash -c 'umask 022; exec "$0" "$1" --user --hooks user-job' "$PY" "$EMIT"
  [ "$status" -eq 0 ]
  [ "$(file_mode "$(user_file)")" = "644" ]
}

# _before_replace is the test seam between "read the file" and "rename over it": a change
# injected there must abort the run instead of being overwritten (lost update).
@test "a change injected through _before_replace aborts without clobbering it" {
  export PYTHONDONTWRITEBYTECODE=1
  seed_user_file '{"theme": "dark"}'
  run "$PY" - "$REPO_ROOT/agent-factory" "$(user_file)" <<'PYEOF'
import sys
sys.path.insert(0, sys.argv[1])
import deploy_hooks as d

target = sys.argv[2]
def inject():
    with open(target, "w") as fh:
        fh.write('{"theme": "light", "added_by": "someone else"}\n')
d._before_replace = inject
sys.argv = ["deploy_hooks.py", "--user", "--hooks", "user-job"]
d.main()
PYEOF
  [ "$status" -ne 0 ]
  [[ "$output" == *"changed while"* ]] || false
  [[ "$output" != *"Traceback"* ]] || false
  # The concurrent writer's content is intact and no temp file is left behind.
  [ "$(jq -r .added_by "$(user_file)")" = "someone else" ]
  [ -z "$(ls -A "$CLAUDE_CONFIG_DIR" | grep -v '^settings.json$' || true)" ]
}

@test "a file created by someone else between the read and the rename is not replaced" {
  export PYTHONDONTWRITEBYTECODE=1
  run "$PY" - "$REPO_ROOT/agent-factory" "$(user_file)" <<'PYEOF'
import os, sys
sys.path.insert(0, sys.argv[1])
import deploy_hooks as d

target = sys.argv[2]
def inject():
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "w") as fh:
        fh.write('{"theirs": true}\n')
d._before_replace = inject
sys.argv = ["deploy_hooks.py", "--user", "--hooks", "user-job"]
d.main()
PYEOF
  [ "$status" -ne 0 ]
  [ "$(jq -r .theirs "$(user_file)")" = "true" ]
}

# ---- the documented reformat contract (D09: document, do not text-patch) ----

@test "a tab-indented settings file is rewritten with 2-space indent, same JSON value" {
  seed_user_file "$(printf '{\n\t"theme": "dark",\n\t"n": 1\n}')"
  cp "$(user_file)" "$MOCK_HOOK_ROOT/orig"
  emit_user
  [ "$status" -eq 0 ]
  ! grep -q "$(printf '\t')" "$(user_file)" || false          # reformatted: no tabs left
  grep -q '^  "theme": "dark",$' "$(user_file)"               # 2-space indent
  # Everything the user had is still there with the same values.
  [ "$(jq -c 'del(.hooks)' "$(user_file)")" = "$(jq -c . "$MOCK_HOOK_ROOT/orig")" ]
}

@test "the reformat of the whole settings file is documented where operators look" {
  grep -qi "reformat" "$REPO_ROOT/agent-factory/deploy_hooks.py"
  grep -qi "reformat" "$REPO_ROOT/hooks/README.md"
  grep -qi "reformat" "$REPO_ROOT/scripts/wire.sh"
}

# ---------------------------------------------------------------------------
# WP-015: ownership is the exact generated command (hardening, refs private WP-015)
# ---------------------------------------------------------------------------

# `$` in a regex accepts a trailing newline, so a command that merely ends in "\n" used to
# count as ours and `off` would sweep it. fullmatch: the whole command, nothing after it.
@test "a command with a trailing newline is not owned (off leaves it)" {
  mkdir -p "$PROJ/.claude"
  # $'..' keeps the trailing newline ($(printf ...) would strip it).
  jq -n --arg a $'bash "/x/hooks/run.sh" guard-min # GENERATED by the-grid deploy_hooks.py\n' \
    '{hooks: {PreToolUse: [{matcher: "Bash", hooks: [{type: "command", command: $a}]}]}}' > "$L"
  cp "$L" "$MOCK_HOOK_ROOT/before"
  set_profile off
  emit
  [ "$status" -eq 0 ]
  cmp "$L" "$MOCK_HOOK_ROOT/before"
}

# The emitter must not persist a launcher path that does not exist (a stray GRID_DIR would
# write a dangling machine-wide SessionEnd command).
@test "--user with a GRID_DIR that has no hooks/run.sh exits non-zero and writes nothing" {
  rm -f "$FGRID/hooks/run.sh"
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"run.sh"* ]] || false
  [ ! -e "$(user_file)" ]
}

@test "--user --hooks \"\" needs no launcher (removing generated entries must still work)" {
  rm -f "$FGRID/hooks/run.sh"
  run "$PY" "$EMIT" --user --hooks ""
  [ "$status" -eq 0 ]
}

@test "--user warns on stderr when GRID_DIR is not the repo this emitter lives in" {
  emit_user
  [ "$status" -eq 0 ]
  [[ "$output" == *"not this checkout"* ]] || false
  [ "$(owned_ids "$(user_file)")" = "user-job" ]
}

@test "--user --check on a symlinked settings file is a non-failing skip" {
  mkdir -p "$CLAUDE_CONFIG_DIR"
  printf '{}\n' > "$MOCK_HOOK_ROOT/real.json"
  ln -s "$MOCK_HOOK_ROOT/real.json" "$(user_file)"
  emit_user --check
  [ "$status" -eq 0 ]
  [[ "$output" == *"deploy_hooks --check: skipped: symlinked settings ($(user_file))"* ]] || false
  # A real run still refuses and leaves the link and its target alone.
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"symlink"* ]] || false
  [ -L "$(user_file)" ]
  [ "$(cat "$MOCK_HOOK_ROOT/real.json")" = "{}" ]
}

@test "--user --check with a symlinked config dir is skipped the same way" {
  mkdir -p "$MOCK_HOOK_ROOT/dotfiles"
  rm -rf "$CLAUDE_CONFIG_DIR"
  ln -s "$MOCK_HOOK_ROOT/dotfiles" "$CLAUDE_CONFIG_DIR"
  emit_user --check
  [ "$status" -eq 0 ]
  [[ "$output" == *"skipped: symlinked settings"* ]] || false
}

# ---------------------------------------------------------------------------
# Hardening H-02 (hardening, refs private H-02): VS10 smalls of the settings rewrite
# ---------------------------------------------------------------------------

# OWNED_RE must not let a control character into the quoted launcher path: `[^"]*` took a
# newline, so a hand-written handler whose command merely LOOKED like ours was swept by `off`.
@test "H-02: a launcher path holding a control character is not owned (off leaves it)" {
  mkdir -p "$PROJ/.claude"
  set_profile off
  local esc
  for esc in '\n' '\r' '\t' '\u0000' '\u001f' '\u007f'; do
    printf '{"hooks":{"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"bash \\"/x%s/hooks/run.sh\\" guard-min # GENERATED by the-grid deploy_hooks.py"}]}]}}\n' "$esc" > "$L"
    cp "$L" "$MOCK_HOOK_ROOT/before"
    emit
    [ "$status" -eq 0 ] || { echo "escape $esc: status $status: $output" >&2; return 1; }
    cmp "$L" "$MOCK_HOOK_ROOT/before" || { echo "escape $esc: file was rewritten" >&2; return 1; }
  done
}

# The same rule from the writing side: a grid path the tightened OWNED_RE would not recognise
# must not be written, or every run would add another unowned copy.
@test "H-02: a grid path with a control character is refused for --user, nothing written" {
  local bad="$MOCK_HOOK_ROOT/gr"$'\t'"id"
  mkdir -p "$bad/hooks"; : > "$bad/hooks/run.sh"; cp "$FGRID/hooks/catalogue.json" "$bad/hooks/"
  export GRID_DIR="$bad"
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"cannot be written safely"* ]] || false
  [ ! -e "$(user_file)" ]
}

@test "H-02: an ordinary generated command is still owned (off removes it)" {
  mkdir -p "$PROJ/.claude"
  set_profile minimal
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "guard-min" ]
  set_profile off
  emit
  [ "$status" -eq 0 ]
  [ -z "$(owned_ids "$L")" ]
}

# file_sig: an in-place rewrite of the same size with the mtime put back is the same
# (inode, mtime, size). ctime cannot be put back from user space, so it is part of the signature.
@test "H-02: a same-size in-place edit with the mtime restored is detected" {
  export PYTHONDONTWRITEBYTECODE=1
  seed_user_file '{"theme": "dark"}'
  run "$PY" - "$REPO_ROOT/agent-factory" "$(user_file)" <<'PYEOF'
import os, sys
sys.path.insert(0, sys.argv[1])
import deploy_hooks as d

target = sys.argv[2]
def inject():
    st = os.stat(target)
    with open(target, "r+") as fh:        # same inode, same size
        fh.write('{"theme": "lite"}')
    os.utime(target, ns=(st.st_atime_ns, st.st_mtime_ns))   # mtime put back
d._before_replace = inject
sys.argv = ["deploy_hooks.py", "--user", "--hooks", "user-job"]
d.main()
PYEOF
  [ "$status" -ne 0 ]
  [[ "$output" == *"changed while"* ]] || false
  [ "$(jq -r .theme "$(user_file)")" = "lite" ]       # the other writer's content is intact
}

# atomic_write: data to disk before the rename, then the directory entry. Without it a crash
# right after the rename can leave an empty or truncated settings file.
@test "H-02: the temp file is fsynced before the rename and the directory after it" {
  export PYTHONDONTWRITEBYTECODE=1
  seed_user_file '{"theme": "dark"}'
  run "$PY" - "$REPO_ROOT/agent-factory" <<'PYEOF'
import os, stat, sys
sys.path.insert(0, sys.argv[1])
import deploy_hooks as d

events = []
real_fsync, real_replace = os.fsync, os.replace
def fsync(fd):
    events.append("fsync-dir" if stat.S_ISDIR(os.fstat(fd).st_mode) else "fsync-file")
    return real_fsync(fd)
def replace(a, b):
    events.append("replace")
    return real_replace(a, b)
os.fsync, os.replace = fsync, replace
sys.argv = ["deploy_hooks.py", "--user", "--hooks", "user-job"]
d.main()
print("EVENTS " + ",".join(events))
PYEOF
  [ "$status" -eq 0 ]
  [[ "$output" == *"EVENTS fsync-file,replace,fsync-dir"* ]] || { echo "$output" >&2; false; }
}

# read_settings: a settings file is a few KB; a huge one is refused before it is parsed.
@test "H-02: a settings file over the size cap is refused and left alone" {
  export PYTHONDONTWRITEBYTECODE=1
  mkdir -p "$CLAUDE_CONFIG_DIR"
  "$PY" - "$REPO_ROOT/agent-factory" "$(user_file)" over <<'PYEOF'
import sys
pad = 1048576 + 1 - len('{"pad": ""}')   # the cap is 1 MiB
open(sys.argv[2], "w").write('{"pad": "' + "a" * pad + '"}')
PYEOF
  [ "$(wc -c < "$(user_file)" | tr -d ' ')" -eq 1048577 ]
  cp "$(user_file)" "$MOCK_HOOK_ROOT/before"
  emit_user
  [ "$status" -ne 0 ]
  [[ "$output" == *"larger than"* ]] || false
  [[ "$output" != *"Traceback"* ]] || false
  cmp "$(user_file)" "$MOCK_HOOK_ROOT/before"
}

@test "H-02: a settings file exactly at the size cap is still read" {
  export PYTHONDONTWRITEBYTECODE=1
  mkdir -p "$CLAUDE_CONFIG_DIR"
  "$PY" - "$REPO_ROOT/agent-factory" "$(user_file)" <<'PYEOF'
import sys
pad = 1048576 - len('{"pad": ""}')
open(sys.argv[2], "w").write('{"pad": "' + "a" * pad + '"}')
PYEOF
  [ "$(wc -c < "$(user_file)" | tr -d ' ')" -eq 1048576 ]
  emit_user --dry-run
  [ "$status" -eq 0 ]
}
