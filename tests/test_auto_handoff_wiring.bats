#!/usr/bin/env bats
# Tests for the machine-level wiring of the auto-handoff hook: `wire.sh` and
# `agent-factory/deploy_hooks.py --user` (change `hook-profiles`, group 4).
#
# Scenarios come from openspec/changes/hook-profiles/specs/auto-handoff/spec.md,
# "Machine-level, on by default, opt-out per machine" (the "Session opt-out"
# scenario is tested with the launcher in tests/test_auto_handoff.bats).
#
# Every test runs the REAL scripts/wire.sh against a MOCK grid (GRID_DIR=$MOCK_GRID)
# that holds a copy of the real hooks/ and agent-factory/deploy_hooks.py, with
# GRID_HOST=testhost. The user settings file is always
# $CLAUDE_CONFIG_DIR/settings.json, a temp dir from common_setup: nothing here can
# reach the real ~/.claude (assert_sandboxed is the tripwire).
#
# These are the author's own checks; independent verification belongs to qa-engineer.

load helpers/setup

setup() {
  common_setup
  # A temp HOME (set AFTER common_setup, which captured REAL_HOME for the sandbox check).
  export HOME="$MOCK_HOOK_ROOT/home"
  mkdir -p "$HOME"
  export GRID_HOST=testhost
  assert_sandboxed

  # Mock grid: one skill, the real hooks/ and the real emitter. No policy.yaml, so
  # the pre-wire audit is skipped (tests that want it copy policy.yaml in).
  make_skill "$MOCK_GRID/skills/skill-alpha" "skill-alpha"
  cp -R "$REPO_ROOT/hooks" "$MOCK_GRID/hooks"
  mkdir -p "$MOCK_GRID/agent-factory" "$MOCK_GRID/machines"
  cp "$REPO_ROOT/agent-factory/deploy_hooks.py" "$MOCK_GRID/agent-factory/deploy_hooks.py"

  SETTINGS="$CLAUDE_CONFIG_DIR/settings.json"
  FIXTURE="$REPO_ROOT/tests/fixtures/hooks/settings-handwritten.json"
  # The command a correct wire writes: absolute path of THIS (mock) grid.
  EXPECT_CMD="bash \"$MOCK_GRID/hooks/run.sh\" auto-handoff # GENERATED by the-grid deploy_hooks.py"
}

teardown() {
  unset GRID_HOST GRID_BASELINE
  common_teardown
}

# wire [args...]: the real wire.sh against the mock grid ($status / $output via `run`).
wire() {
  GRID_DIR="$MOCK_GRID" run bash "$REPO_ROOT/scripts/wire.sh" "$@"
}

# generated_count: how many generated (GENERATED-marked) handlers the settings file holds.
generated_count() {
  jq '[.. | objects | select(has("command")) | .command | select(test("# GENERATED by the-grid"))] | length' "$SETTINGS"
}

# generated_commands: every generated command string, one per line.
generated_commands() {
  jq -r '.. | objects | select(has("command")) | .command | select(test("# GENERATED by the-grid"))' "$SETTINGS"
}

# ---------------------------------------------------------------- on / off / layering

@test "on by default: one generated SessionEnd entry and a wired hook row" {
  wire
  [ "$status" -eq 0 ]
  [ "$(generated_count)" -eq 1 ]
  [ "$(jq '.hooks.SessionEnd | length' "$SETTINGS")" -eq 1 ]
  [ "$(generated_commands)" = "$EXPECT_CMD" ]
  # The manifest row: kind, name, settings path, status, (empty) reason.
  grep -qxF "$(printf 'hook\tauto-handoff\t%s\twired\t' "$SETTINGS")" "$MOCK_GRID/.wired.manifest"
}

@test "the emitted command resolves: run through bash it reaches the launcher (kill switch exits 0)" {
  wire
  [ "$status" -eq 0 ]
  # GRID_HOOKS=off makes the launcher exit 0 before any hook runs; a wrong path would be 127.
  run env GRID_HOOKS=off bash -c "$(generated_commands)"
  [ "$status" -eq 0 ]
}

@test "machine opt-out: -hook:auto-handoff removes the entry and the row is off" {
  wire
  [ "$(generated_count)" -eq 1 ]
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  [ "$status" -eq 0 ]
  [ "$(generated_count)" -eq 0 ]
  grep -qxF "$(printf 'hook\tauto-handoff\t%s\toff\t' "$SETTINGS")" "$MOCK_GRID/.wired.manifest"
}

@test "opt-out on a machine that never had the entry creates no settings file" {
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  [ "$status" -eq 0 ]
  [ ! -e "$SETTINGS" ]
}

@test "later manifest wins: a local overlay re-enables what the baseline switched off" {
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/baseline.txt"
  export GRID_BASELINE="$MOCK_GRID/baseline.txt"
  wire
  [ "$status" -eq 0 ]
  [ ! -e "$SETTINGS" ]
  printf 'hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.local.txt"
  wire
  [ "$status" -eq 0 ]
  [ "$(generated_count)" -eq 1 ]
}

@test "later manifest wins: a local overlay can switch off what the machine overlay enabled" {
  printf 'hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  [ "$(generated_count)" -eq 1 ]
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.local.txt"
  wire
  [ "$status" -eq 0 ]
  [ "$(generated_count)" -eq 0 ]
}

@test "an unknown hook entry warns, is ignored, and wiring still succeeds" {
  printf 'hook:foo\n-hook:bar\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  [ "$status" -eq 0 ]
  [[ "$output" == *"warning: unknown hook foo"* ]]
  [[ "$output" == *"warning: unknown hook bar"* ]]
  [ "$(generated_count)" -eq 1 ]
  [ -L "$MOCK_SKILLS/skill-alpha" ]
}

# ---------------------------------------------------------------- non-clobbering

@test "hand-written user hooks and keys survive; the second wire is a byte-identical no-op" {
  cp "$FIXTURE" "$SETTINGS"
  wire
  [ "$status" -eq 0 ]
  [ "$(generated_count)" -eq 1 ]
  # Only the one generated handler differs from the fixture, and key order is kept.
  [ "$(jq -S 'del(.hooks.SessionEnd[0].hooks[] | select(.command | test("GENERATED")))' "$SETTINGS")" = "$(jq -S . "$FIXTURE")" ]
  [ "$(jq -c 'keys_unsorted' "$SETTINGS")" = "$(jq -c 'keys_unsorted' "$FIXTURE")" ]
  [ "$(jq -r '.hooks.SessionEnd[0].hooks[0].command' "$SETTINGS")" = "echo handwritten-session-end" ]

  # Second run: same bytes, and the file is not even rewritten (mtime check without
  # stat flags: age the file and a reference, run again, the file must not be newer).
  cp "$SETTINGS" "$BATS_TEST_TMPDIR/after-first"
  touch -t 200001010000 "$SETTINGS" "$BATS_TEST_TMPDIR/ref"
  wire
  [ "$status" -eq 0 ]
  cmp "$SETTINGS" "$BATS_TEST_TMPDIR/after-first"
  [ ! "$SETTINGS" -nt "$BATS_TEST_TMPDIR/ref" ]
}

@test "opting out afterwards restores the hand-written file byte for byte" {
  cp "$FIXTURE" "$SETTINGS"
  wire
  [ "$(generated_count)" -eq 1 ]
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  [ "$status" -eq 0 ]
  cmp "$SETTINGS" "$FIXTURE"
}

@test "a second wire leaves .wired.manifest and the links unchanged too" {
  wire
  cp "$MOCK_GRID/.wired.manifest" "$BATS_TEST_TMPDIR/manifest-1"
  wire
  [ "$status" -eq 0 ]
  cmp "$MOCK_GRID/.wired.manifest" "$BATS_TEST_TMPDIR/manifest-1"
  [ -L "$MOCK_SKILLS/skill-alpha" ]
}

@test "the settings file never contains the real home (mock grid is outside it)" {
  case "$MOCK_GRID" in "$REAL_HOME"/*) skip "mock grid is under the real home" ;; esac
  cp "$FIXTURE" "$SETTINGS"
  wire
  [ "$status" -eq 0 ]
  ! grep -qF "$REAL_HOME" "$SETTINGS"
}

# ---------------------------------------------------------------- --check

@test "--check passes after a wire and reports nothing to fix" {
  wire
  wire --check
  [ "$status" -eq 0 ]
  [[ "$output" == *"live links match a fresh wire"* ]]
}

@test "--check reports a deleted entry, exits 1, names the hook and writes nothing" {
  wire
  jq 'del(.hooks.SessionEnd)' "$SETTINGS" > "$BATS_TEST_TMPDIR/s.json"
  cp "$BATS_TEST_TMPDIR/s.json" "$SETTINGS"
  cp "$SETTINGS" "$BATS_TEST_TMPDIR/before"
  wire --check
  [ "$status" -eq 1 ]
  [[ "$output" == *"auto-handoff"* ]]
  cmp "$SETTINGS" "$BATS_TEST_TMPDIR/before"
  # And a real wire afterwards repairs it.
  wire
  [ "$status" -eq 0 ]
  [ "$(generated_count)" -eq 1 ]
}

@test "--check on a machine with no settings file reports the missing entry and creates nothing" {
  # Link the skills first with the hook off, so the only drift is the missing entry.
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  rm "$MOCK_GRID/machines/testhost.txt"
  wire --check
  [ "$status" -eq 1 ]
  [[ "$output" == *"auto-handoff"* ]]
  [ ! -e "$SETTINGS" ]
}

@test "--check with the hook switched off passes when no entry exists" {
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  wire --check
  [ "$status" -eq 0 ]
  [ ! -e "$SETTINGS" ]
}

@test "--check still skips quietly for a grid without the emitter" {
  rm "$MOCK_GRID/agent-factory/deploy_hooks.py"
  wire
  wire --check
  [ "$status" -eq 0 ]
  [ ! -e "$SETTINGS" ]
}

# ---------------------------------------------------------------- emitter edges

@test "deploy_hooks --user rejects a project-scope id: exit 2, nothing written" {
  GRID_DIR="$MOCK_GRID" run python3 "$MOCK_GRID/agent-factory/deploy_hooks.py" --user --hooks pre-bash-no-bypass
  [ "$status" -eq 2 ]
  [[ "$output" == *"project-scope"* ]]
  [ ! -e "$SETTINGS" ]
}

@test "deploy_hooks --user rejects an unknown id even next to a valid one: exit 2, nothing written" {
  GRID_DIR="$MOCK_GRID" run python3 "$MOCK_GRID/agent-factory/deploy_hooks.py" --user --hooks auto-handoff,nope
  [ "$status" -eq 2 ]
  [[ "$output" == *"unknown hook id"* ]]
  [ ! -e "$SETTINGS" ]
}

@test "deploy_hooks --user needs --hooks and takes no project directory" {
  GRID_DIR="$MOCK_GRID" run python3 "$MOCK_GRID/agent-factory/deploy_hooks.py" --user
  [ "$status" -eq 2 ]
  GRID_DIR="$MOCK_GRID" run python3 "$MOCK_GRID/agent-factory/deploy_hooks.py" --user --hooks auto-handoff "$OTHER_DIR"
  [ "$status" -eq 2 ]
}

@test "deploy_hooks --user --dry-run shows the plan and writes nothing" {
  GRID_DIR="$MOCK_GRID" run python3 "$MOCK_GRID/agent-factory/deploy_hooks.py" --user --hooks auto-handoff --dry-run
  [ "$status" -eq 0 ]
  [[ "$output" == *"missing"*"auto-handoff"* ]]
  [ ! -e "$SETTINGS" ]
}

@test "deploy_hooks --user keeps a hand-written hook that merely mentions the launcher" {
  # Not the exact generated shape, so it is hand-written and must be left alone.
  printf '%s\n' '{"hooks":{"SessionEnd":[{"hooks":[{"type":"command","command":"bash /x/hooks/run.sh auto-handoff"}]}]}}' > "$SETTINGS"
  wire
  [ "$status" -eq 0 ]
  [ "$(generated_count)" -eq 1 ]
  [ "$(jq '[.. | objects | select(.command == "bash /x/hooks/run.sh auto-handoff")] | length' "$SETTINGS")" -eq 1 ]
  printf -- '-hook:auto-handoff\n' > "$MOCK_GRID/machines/testhost.txt"
  wire
  [ "$(jq '[.. | objects | select(.command == "bash /x/hooks/run.sh auto-handoff")] | length' "$SETTINGS")" -eq 1 ]
}

@test "invalid JSON in the settings file: wire warns, exits 0, and the file is untouched" {
  printf '{ not json\n' > "$SETTINGS"
  wire
  [ "$status" -eq 0 ]
  [[ "$output" == *"warning: deploy_hooks.py --user failed"* ]]
  [ "$(cat "$SETTINGS")" = "{ not json" ]
  [ -L "$MOCK_SKILLS/skill-alpha" ]
  grep -qF "$(printf 'hook\tauto-handoff\t%s\tfailed\t' "$SETTINGS")" "$MOCK_GRID/.wired.manifest"
}

@test "a symlinked settings file is refused: wire warns, exits 0, the link is kept" {
  printf '{}\n' > "$MOCK_HOOK_ROOT/real-settings.json"
  ln -s "$MOCK_HOOK_ROOT/real-settings.json" "$SETTINGS"
  wire
  [ "$status" -eq 0 ]
  [[ "$output" == *"refusing"* ]]
  [[ "$output" == *"warning: deploy_hooks.py --user failed"* ]]
  [ -L "$SETTINGS" ]
  [ "$(cat "$MOCK_HOOK_ROOT/real-settings.json")" = "{}" ]
}

# ---------------------------------------------------------------- failure and skip paths

@test "without python3, wire still exits 0, warns, links skills and writes no settings file" {
  PATH="$(path_without 'python3*')" wire
  [ "$status" -eq 0 ]
  [[ "$output" == *"warning: python3 not found; auto-handoff not wired"* ]]
  [ -L "$MOCK_SKILLS/skill-alpha" ]
  [ ! -e "$SETTINGS" ]
}

@test "a grid without the emitter wires silently: no settings file, no hook row" {
  rm "$MOCK_GRID/agent-factory/deploy_hooks.py"
  wire
  [ "$status" -eq 0 ]
  [[ "$output" != *"auto-handoff"* ]]
  [ ! -e "$SETTINGS" ]
  ! grep -q '^hook' "$MOCK_GRID/.wired.manifest"
}

@test "GRID_SKIP_CATALOG alone also skips the hook step" {
  GRID_SKIP_CATALOG=1 wire
  [ "$status" -eq 0 ]
  [ ! -e "$SETTINGS" ]
}

# ---------------------------------------------------------------- dry runs never reach a settings file

@test "audit.sh --wired (its dry run uses GRID_DRY_HOME) leaves the settings file alone" {
  # Mock grid set up for the real audit (policy + empty allowlist + .gitmodules).
  cp "$REPO_ROOT/policy.yaml" "$MOCK_GRID/policy.yaml"
  printf '```audit-allow\n```\n' > "$MOCK_GRID/CURATION.md"
  : > "$MOCK_GRID/.gitmodules"

  # No settings file yet: the audit must not create one.
  GRID_DIR="$MOCK_GRID" run bash "$REPO_ROOT/scripts/audit.sh" --wired
  [ "$status" -eq 0 ]
  [ ! -e "$SETTINGS" ]

  # With a wired file: byte-identical afterwards.
  wire
  [ "$status" -eq 0 ]
  cp "$SETTINGS" "$BATS_TEST_TMPDIR/before"
  GRID_DIR="$MOCK_GRID" run bash "$REPO_ROOT/scripts/audit.sh" --wired
  [ "$status" -eq 0 ]
  cmp "$SETTINGS" "$BATS_TEST_TMPDIR/before"
}

@test "G1 sentinel: a dry-home wire never touches the settings file CLAUDE_CONFIG_DIR points at" {
  # A fake REAL home holding a sentinel settings file; CLAUDE_CONFIG_DIR points at it.
  local fake_home="$BATS_TEST_TMPDIR/realhome"
  mkdir -p "$fake_home/.claude"
  cp "$FIXTURE" "$fake_home/.claude/settings.json"
  cp "$fake_home/.claude/settings.json" "$BATS_TEST_TMPDIR/sentinel"
  HOME="$fake_home" CLAUDE_CONFIG_DIR="$fake_home/.claude" GRID_DRY_HOME="$BATS_TEST_TMPDIR/dry" wire
  [ "$status" -eq 0 ]
  cmp "$fake_home/.claude/settings.json" "$BATS_TEST_TMPDIR/sentinel"
  [ ! -e "$BATS_TEST_TMPDIR/dry/.claude/settings.json" ]
  # A dry run also leaves the mock grid's own state alone.
  [ ! -e "$MOCK_GRID/.wired.manifest" ]
}

# ---------------------------------------------------------------- WP-015 (hardening, refs private WP-015)

@test "GRID_DIR without hooks/run.sh exits non-zero and writes nothing" {
  rm "$MOCK_GRID/hooks/run.sh"
  GRID_DIR="$MOCK_GRID" run python3 "$MOCK_GRID/agent-factory/deploy_hooks.py" --user --hooks auto-handoff
  [ "$status" -ne 0 ]
  [[ "$output" == *"run.sh not found"* ]]
  [ ! -e "$SETTINGS" ]
  # Through wire.sh it is the usual warning and a clean exit, never a dangling entry.
  wire
  [ "$status" -eq 0 ]
  [[ "$output" == *"warning: deploy_hooks.py --user failed"* ]]
  [ ! -e "$SETTINGS" ]
}

@test "a symlinked settings file: wire.sh --check exits 0 and says skipped; a real wire still warns and keeps the link" {
  printf '{}\n' > "$MOCK_HOOK_ROOT/real-settings.json"
  ln -s "$MOCK_HOOK_ROOT/real-settings.json" "$SETTINGS"
  wire
  [ "$status" -eq 0 ]
  [[ "$output" == *"warning: deploy_hooks.py --user failed"* ]]
  [ -L "$SETTINGS" ]
  wire --check
  [ "$status" -eq 0 ]
  [[ "$output" == *"skipped: symlinked settings"* ]]
  [ -L "$SETTINGS" ]
  [ "$(cat "$MOCK_HOOK_ROOT/real-settings.json")" = "{}" ]
}
