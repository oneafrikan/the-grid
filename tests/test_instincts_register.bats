#!/usr/bin/env bats
# Tests for the opt-in registration of the instincts hooks (openspec change `instincts`,
# group 6): the four hooks/catalogue.json entries, their wrapper scripts, the
# `opt_in: learning` rule in agent-factory/deploy_hooks.py, and the `learning` key in
# deploy.py's project.yaml loader.
#
# Emission tests run the real emitter against the REAL catalogue (GRID_DIR = repo root),
# because the thing under test is the real four entries. Catalogue-validation tests use a
# fixture grid. Every project, HOME and state dir is a temp dir, and `claude` is never
# called (the tripwire from common_setup stays armed).
#
# Needs the agent-factory venv (the emitter reads project.yaml with PyYAML); skipped where
# it is not built, like tests/test_deploy.bats.
#
# Self-check by the implementer; independent verification belongs to qa-engineer / sdet.

bats_require_minimum_version 1.5.0

load helpers/setup
load helpers/venv

# The four ids, sorted the way owned_ids() prints them.
FOUR="instincts-capture-failure,instincts-capture-prompt,instincts-capture-tool,instincts-inject"

setup() {
  common_setup
  # A temp HOME, set AFTER common_setup (which captured REAL_HOME for the sandbox check).
  export HOME="$MOCK_HOOK_ROOT/home"
  mkdir -p "$HOME"
  PY="$REPO_ROOT/agent-factory/.venv/bin/python"
  require_venv "$PY"
  EMIT="$REPO_ROOT/agent-factory/deploy_hooks.py"
  DEPLOY="$REPO_ROOT/agent-factory/deploy.py"
  export PYTHONDONTWRITEBYTECODE=1
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GRID_HOST GRID_INSTINCTS GRID_INSTINCTS_SKIP \
        GRID_LOOP_HEADLESS GRID_AUTOHANDOFF_CHILD GRID_CRON GRID_HOOKS GRID_DISABLED_HOOKS
  export GRID_DIR="$REPO_ROOT"
  export GRID_STATE_DIR="$MOCK_HOOK_ROOT/gstate"
  export GRID_LEARNING_DIR="$MOCK_HOOK_ROOT/learning"
  PROJ="$MOCK_HOOK_ROOT/proj"
  mkdir -p "$PROJ/.grid"
  # A real git repo with a fake origin: capture needs a project id.
  git -C "$PROJ" init -q
  git -C "$PROJ" remote add origin https://example.test/owner/repo.git
  L="$PROJ/.claude/settings.local.json"
  S="$PROJ/.claude/settings.json"
}

teardown() {
  common_teardown
}

# yaml <text>: write $PROJ/.grid/project.yaml verbatim (printf %b so \n works).
yaml() { printf '%b' "$1" > "$PROJ/.grid/project.yaml"; }

# emit [args]: run the emitter on $PROJ (status/output captured by bats).
emit() { run "$PY" "$EMIT" "$PROJ" "$@"; }

# owned_ids <settings file>: sorted, comma-joined ids of every generated handler in it.
owned_ids() {
  jq -r '[.. | objects | .command? | strings | select(contains("GENERATED by the-grid deploy_hooks.py")) | split(" ")[2]] | sort | join(",")' "$1"
}

# instincts_ids <settings file>: like owned_ids, but only the instincts-* ones.
instincts_ids() {
  jq -r '[.. | objects | .command? | strings | select(contains("GENERATED by the-grid deploy_hooks.py")) | split(" ")[2] | select(startswith("instincts-"))] | sort | join(",")' "$1"
}

# ---------------------------------------------------------------------------
# Catalogue entries and wrapper scripts
# ---------------------------------------------------------------------------

@test "the four catalogue entries match the design table" {
  run jq -e '
    def e($id): .hooks[] | select(.id == $id);
    (e("instincts-capture-tool")    | .event == "PostToolUse"        and .matcher == "Bash|Edit|Write|MultiEdit|NotebookEdit" and .timeout == 2),
    (e("instincts-capture-failure") | .event == "PostToolUseFailure" and .matcher == "Bash|Edit|Write|MultiEdit|NotebookEdit" and .timeout == 2),
    (e("instincts-capture-prompt")  | .event == "UserPromptSubmit"   and (has("matcher") | not) and .timeout == 2),
    (e("instincts-inject")          | .event == "SessionStart"       and (has("matcher") | not) and .timeout == 5),
    (.hooks | map(select(.id | startswith("instincts-"))) | length == 4
       and all(.[]; .opt_in == "learning" and (has("min_profile") | not) and .scope == "project"
                    and .fail == "open" and .model_cost == false
                    and (.cost | length) > 0 and (.description | length) > 0))' \
    "$REPO_ROOT/hooks/catalogue.json"
  [ "$status" -eq 0 ] || { echo "$output" >&2; false; }
}

@test "each wrapper is one exec line into scripts/instincts.sh" {
  for id in instincts-capture-tool instincts-capture-failure instincts-capture-prompt; do
    f="$REPO_ROOT/hooks/scripts/$id.sh"
    [ -f "$f" ]
    grep -q '^exec bash "$(cd "$(dirname "$0")/../.." && pwd -P)/scripts/instincts.sh" capture$' "$f"
  done
  # the inject wrapper is fail-silent: output of a failed run is dropped and the status is always 0
  grep -q 'scripts/instincts.sh" inject 2>/dev/null$' "$REPO_ROOT/hooks/scripts/instincts-inject.sh"
  [ "$(tail -1 "$REPO_ROOT/hooks/scripts/instincts-inject.sh")" = "exit 0" ]
}

# ---------------------------------------------------------------------------
# Emitter: the opt-in rule
# ---------------------------------------------------------------------------

@test "flag on emits the four entries under every profile, flag off emits none" {
  for p in off minimal standard strict; do
    rm -rf "$PROJ/.claude"
    yaml "hooks:\n  profile: $p\nlearning: on\n"
    emit
    [ "$status" -eq 0 ] || { echo "$output" >&2; false; }
    [ "$(instincts_ids "$L")" = "$FOUR" ] || { echo "profile $p: $(instincts_ids "$L")" >&2; false; }

    rm -rf "$PROJ/.claude"
    yaml "hooks:\n  profile: $p\nlearning: off\n"
    emit
    [ "$status" -eq 0 ]
    # Flag off: no instincts entry (the file may exist for the guards, but never holds them).
    if [ -e "$L" ]; then [ -z "$(instincts_ids "$L")" ]; fi
  done
}

@test "flag on works when hooks: is absent, and an absent flag emits nothing" {
  yaml 'learning: on\n'
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "$FOUR" ]
  rm -rf "$PROJ/.claude"
  yaml 'context: |\n  a fact\n'
  emit
  [ "$status" -eq 0 ]
  [ ! -e "$PROJ/.claude" ]
}

@test "learning true, \"on\", \"TRUE\" behave as on; other values behave as off" {
  for v in true '"on"' '"TRUE"' On; do
    rm -rf "$PROJ/.claude"
    yaml "learning: $v\n"
    emit
    [ "$status" -eq 0 ]
    [ "$(owned_ids "$L")" = "$FOUR" ] || { echo "value $v" >&2; false; }
  done
  for v in false '"off"' '"yes"' 1 '"maybe"'; do
    rm -rf "$PROJ/.claude"
    yaml "learning: $v\n"
    emit
    [ "$status" -eq 0 ]
    [ ! -e "$PROJ/.claude" ] || { echo "value $v wrote a file" >&2; false; }
  done
}

@test "the instincts entries sit alongside the profile's guards, with the catalogue event and matcher" {
  yaml 'hooks:\n  profile: standard\nlearning: on\n'
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "instincts-capture-failure,instincts-capture-prompt,instincts-capture-tool,instincts-inject,pre-bash-no-bypass,pre-bash-secret-scan" ]
  # event and matcher come from the catalogue
  run jq -e '
    (.hooks.PostToolUse[0].matcher == "Bash|Edit|Write|MultiEdit|NotebookEdit")
    and (.hooks.PostToolUseFailure[0].matcher == "Bash|Edit|Write|MultiEdit|NotebookEdit")
    and (.hooks.UserPromptSubmit[0] | has("matcher") | not)
    and (.hooks.SessionStart[0] | has("matcher") | not)
    and (.hooks.SessionStart[0].hooks[0].timeout == 5)
    and (.hooks.UserPromptSubmit[0].hooks[0].timeout == 2)' "$L"
  [ "$status" -eq 0 ] || { echo "$output" >&2; cat "$L" >&2; false; }
}

@test "hooks.target: shared puts the instincts entries in settings.json" {
  yaml 'hooks:\n  target: shared\nlearning: on\n'
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$S")" = "$FOUR" ]
  [ ! -e "$L" ]
}

@test "a hand-written hook survives, and flipping the flag off removes exactly the four entries" {
  mkdir -p "$PROJ/.claude"
  cp "$REPO_ROOT/tests/fixtures/hooks/settings-handwritten.json" "$L"
  yaml 'hooks:\n  profile: minimal\nlearning: on\n'
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "$FOUR,pre-bash-no-bypass" ]
  # the hand-written hook is still there, unmodified
  jq -e '[.. | objects | .command? | strings] | index("echo handwritten-bash-hook") != null' "$L" >/dev/null

  yaml 'hooks:\n  profile: minimal\nlearning: off\n'
  emit
  [ "$status" -eq 0 ]
  [ "$(owned_ids "$L")" = "pre-bash-no-bypass" ]
  jq -e '[.. | objects | .command? | strings] | index("echo handwritten-bash-hook") != null' "$L" >/dev/null
  # Same settings as a profile-only run from the same starting file.
  cp "$REPO_ROOT/tests/fixtures/hooks/settings-handwritten.json" "$MOCK_HOOK_ROOT/expected.json"
  rm -rf "$PROJ/.claude"; mkdir -p "$PROJ/.claude"
  cp "$MOCK_HOOK_ROOT/expected.json" "$L"
  emit
  [ "$status" -eq 0 ]
  cp "$L" "$MOCK_HOOK_ROOT/profile-only.json"
  # flip on, then off again: byte-identical to the profile-only result
  yaml 'hooks:\n  profile: minimal\nlearning: on\n'
  emit
  yaml 'hooks:\n  profile: minimal\nlearning: off\n'
  emit
  cmp "$L" "$MOCK_HOOK_ROOT/profile-only.json"
}

@test "running twice is byte-identical" {
  yaml 'hooks:\n  profile: standard\nlearning: on\n'
  emit
  [ "$status" -eq 0 ]
  cp "$L" "$MOCK_HOOK_ROOT/first.json"
  emit
  [ "$status" -eq 0 ]
  cmp "$L" "$MOCK_HOOK_ROOT/first.json"
  [[ "$output" == *"0 written"* ]] || { echo "$output" >&2; false; }
}

@test "emitted commands match the ownership regex and carry no absolute home path" {
  yaml 'learning: on\n'
  emit
  [ "$status" -eq 0 ]
  # The OWNED_RE shape from deploy_hooks.py, applied to every instincts command.
  run jq -r '.. | objects | .command? | strings | select(contains("instincts-"))' "$L"
  [ "$status" -eq 0 ]
  [ "$(printf '%s\n' "$output" | wc -l)" -eq 4 ]
  while IFS= read -r cmd; do
    [[ "$cmd" =~ ^bash\ \"[^\"]*/hooks/run\.sh\"\ instincts-[a-z-]+\ \#\ GENERATED\ by\ the-grid\ deploy_hooks\.py$ ]] \
      || { echo "bad command: $cmd" >&2; false; }
    [[ "$cmd" != */Users/* && "$cmd" != */home/* ]] || { echo "absolute path: $cmd" >&2; false; }
  done <<<"$output"
  ! grep -q '/Users/\|/home/' "$L" || false
}

@test "hooks: {enable: [...]} keeps the existing unknown-key error and writes nothing" {
  yaml 'hooks:\n  enable: [instincts-inject]\nlearning: on\n'
  emit
  [ "$status" -ne 0 ]
  [[ "$output" == *"unknown key"* ]] || false
  [[ "$output" == *profile* && "$output" == *target* ]] || { echo "$output" >&2; false; }
  [ ! -e "$PROJ/.claude" ]
}

@test "--check reports drift when the flag is on but nothing is emitted, then passes" {
  yaml 'learning: on\n'
  run "$PY" "$EMIT" "$PROJ" --check
  [ "$status" -eq 1 ]
  [[ "$output" == *"missing"*"instincts-inject"* ]] || { echo "$output" >&2; false; }
  emit
  run "$PY" "$EMIT" "$PROJ" --check
  [ "$status" -eq 0 ]
}

@test "--list shows opt-in:learning in the profile column for the four, and no other hook" {
  run "$PY" "$EMIT" --list
  [ "$status" -eq 0 ]
  [ "$(grep -c 'opt-in:learning' <<<"$output")" -eq 4 ]
  for id in instincts-capture-tool instincts-capture-failure instincts-capture-prompt instincts-inject; do
    grep "^$id " <<<"$output" | grep -q 'opt-in:learning'
  done
  grep '^pre-bash-no-bypass' <<<"$output" | grep -q 'minimal'
}

# ---------------------------------------------------------------------------
# Catalogue validation: exactly one of min_profile / opt_in
# ---------------------------------------------------------------------------

# fixture_grid <hook-json>: a one-hook fixture grid at $MOCK_HOOK_ROOT/fg; sets GRID_DIR.
fixture_grid() {
  mkdir -p "$MOCK_HOOK_ROOT/fg/hooks"
  printf '{"version":1,"hooks":[%s]}\n' "$1" > "$MOCK_HOOK_ROOT/fg/hooks/catalogue.json"
  export GRID_DIR="$MOCK_HOOK_ROOT/fg"
}

BASE='"id":"h1","scope":"project","event":"PostToolUse","timeout":2,"model_cost":false,"cost":"0 tokens.","description":"x"'

@test "catalogue validation: an entry with both min_profile and opt_in is rejected" {
  fixture_grid "{$BASE,\"min_profile\":\"minimal\",\"opt_in\":\"learning\"}"
  run "$PY" "$EMIT" --list
  [ "$status" -ne 0 ]
  [[ "$output" == *h1* && "$output" == *opt_in* ]] || { echo "$output" >&2; false; }
}

@test "catalogue validation: neither min_profile nor opt_in is rejected for a project hook" {
  fixture_grid "{$BASE}"
  run "$PY" "$EMIT" --list
  [ "$status" -ne 0 ]
}

@test "catalogue validation: opt_in accepts only the value learning" {
  fixture_grid "{$BASE,\"opt_in\":\"telemetry\"}"
  run "$PY" "$EMIT" --list
  [ "$status" -ne 0 ]
  [[ "$output" == *learning* ]] || { echo "$output" >&2; false; }
  fixture_grid "{$BASE,\"opt_in\":\"learning\"}"
  run "$PY" "$EMIT" --list
  [ "$status" -eq 0 ]
}

# ---------------------------------------------------------------------------
# deploy.py accepts the `learning` key
# ---------------------------------------------------------------------------

@test "deploy.py accepts a project.yaml containing learning: on" {
  yaml 'learning: on\ncontext: |\n  A-FACT\n'
  run "$PY" "$DEPLOY" "$PROJ" --roles qa-engineer
  [ "$status" -eq 0 ] || { echo "$output" >&2; false; }
  grep -q "A-FACT" "$PROJ/.claude/agents/grid-qa-engineer.md"
}

@test "deploy.py still rejects an unknown top-level key, and the error names learning" {
  yaml 'learnin: on\n'
  run "$PY" "$DEPLOY" "$PROJ" --roles qa-engineer
  [ "$status" -ne 0 ]
  [[ "$output" == *learning* ]] || { echo "$output" >&2; false; }
}

# ---------------------------------------------------------------------------
# End to end through the real launcher
# ---------------------------------------------------------------------------

# prompt_payload: a UserPromptSubmit payload for $PROJ, built from the captured fixture.
prompt_payload() {
  jq --arg d "$PROJ" '.hook_event_name = "UserPromptSubmit" | del(.tool_name, .tool_input)
    | .cwd = $d | .prompt = "please add a retry to the fetcher"' \
    "$REPO_ROOT/tests/fixtures/hooks/pretooluse-bash.json"
}

# obs_lines: total observation lines written under the state dir (0 when none).
obs_lines() {
  cat "$GRID_STATE_DIR"/instincts/*/obs-*.jsonl 2>/dev/null | wc -l | tr -d ' '
}

@test "run.sh instincts-capture-prompt writes one observation in an opted-in repo" {
  yaml 'learning: on\n'
  emit                                   # writes the machine-local marker capture requires
  [ "$status" -eq 0 ]
  run bash "$REPO_ROOT/hooks/run.sh" instincts-capture-prompt < <(prompt_payload)
  [ "$status" -eq 0 ]
  [ -z "$output" ]
  [ "$(obs_lines)" -eq 1 ]
  grep -q '"ev": *"prompt"' "$GRID_STATE_DIR"/instincts/*/obs-*.jsonl
}

@test "GRID_DISABLED_HOOKS=instincts-capture-prompt stops the capture" {
  yaml 'learning: on\n'
  GRID_DISABLED_HOOKS=instincts-capture-prompt run bash "$REPO_ROOT/hooks/run.sh" instincts-capture-prompt < <(prompt_payload)
  [ "$status" -eq 0 ]
  [ "$(obs_lines)" -eq 0 ]
}

@test "an opted-out repo captures nothing even through the launcher (defence in depth)" {
  yaml 'learning: off\n'
  run bash "$REPO_ROOT/hooks/run.sh" instincts-capture-prompt < <(prompt_payload)
  [ "$status" -eq 0 ]
  [ "$(obs_lines)" -eq 0 ]
}

# ---------------------------------------------------------------------------
# WP-028: one parser for emitter and capture, the machine-local marker, the notice
# ---------------------------------------------------------------------------

# marker_file — the machine-local marker the emitter writes for $PROJ.
marker_file() { printf '%s/instincts/enabled/%s' "$GRID_STATE_DIR" "$(bash "$REPO_ROOT/scripts/instincts.sh" project-id "$PROJ")"; }

@test "emitter and capture agree on every learning value (shared parser parity)" {
  while IFS='|' read -r want text; do
    rm -rf "$PROJ/.claude"
    yaml "$text"
    emit
    [ "$status" -eq 0 ]
    if [ "$want" = 1 ]; then
      [ "$(owned_ids "$L")" = "$FOUR" ] || { echo "want on for: $text" >&2; false; }
    else
      [ ! -e "$PROJ/.claude" ] || { echo "want off for: $text" >&2; false; }
    fi
    # the capture-side reader says the same
    got="$("$PY" -B -I -c 'import sys; sys.path.insert(0, sys.argv[1]); import lib; print(int(lib.read_learning_flag(open(sys.argv[2]).read())))' "$REPO_ROOT/scripts/instincts" "$PROJ/.grid/project.yaml")"
    [ "$got" = "$want" ] || { echo "capture parser says $got for: $text" >&2; false; }
  done <<'EOF'
1|learning: on\n
1|learning: true\n
1|learning: "ON"\n
1|learning: 'on'\n
1|learning: on # note\n
1|learning: off\nlearning: on\n
0|learning: on\nlearning: off\n
0|learning: on\nname: x\nlearning: off\n
0|learning: yes\n
0|learning: Yes\n
0|learning: 1\n
0|learning: "maybe"\n
EOF
}

@test "a trailing 'learning: off' removes the hooks that 'learning: on' emitted" {
  yaml 'learning: on\n'
  emit
  [ "$(owned_ids "$L")" = "$FOUR" ]
  yaml 'learning: on\nlearning: off\n'
  emit
  [ "$status" -eq 0 ]
  [ -z "$(instincts_ids "$L" 2>/dev/null || true)" ]
}

@test "emitting the instincts hooks creates the 0600 marker holding the project root" {
  yaml 'learning: on\n'
  emit
  [ "$status" -eq 0 ]
  m="$(marker_file)"
  [ -f "$m" ]
  [ "$(stat -c %a "$m")" = 600 ]
  [ "$(stat -c %a "$(dirname "$m")")" = 700 ]
  [ "$(cat "$m")" = "$(cd "$PROJ" && pwd -P)" ]
}

@test "the marker is removed when learning goes off, and a second run is a clean no-op" {
  yaml 'learning: on\n'
  emit
  [ -f "$(marker_file)" ]
  yaml 'learning: off\n'
  emit
  [ "$status" -eq 0 ]
  [ ! -e "$(marker_file)" ]
  emit
  [ "$status" -eq 0 ]
  [ ! -e "$(marker_file)" ]
}

@test "--check and --dry-run create no marker and print no notice" {
  yaml 'learning: on\n'
  emit --dry-run
  [ ! -e "$(marker_file)" ]
  [[ "$output" != *"recorded locally"* ]] || false
  emit --check || true
  [ ! -e "$(marker_file)" ]
}

@test "the data-use notice is printed once per run that emits the instincts hooks" {
  yaml 'learning: on\n'
  emit
  [ "$(grep -c 'recorded locally' <<<"$output")" -eq 1 ]
  [[ "$output" == *"sent to a model weekly"* ]] || false
  yaml 'learning: off\n'
  emit
  [[ "$output" != *"recorded locally"* ]] || false
}

@test "no git remote: hooks are emitted, no marker, and the warning says capture stays off" {
  git -C "$PROJ" remote remove origin
  yaml 'learning: on\n'
  emit
  [ "$status" -eq 0 ]
  [[ "$output" == *"no git remote"* ]] || false
  [ "$(owned_ids "$L")" = "$FOUR" ]
}
