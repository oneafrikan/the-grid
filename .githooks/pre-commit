#!/usr/bin/env bash
# pre-commit — thin shim; all logic lives in scripts/gate.sh. It runs the FAST mode
# (gate.sh --pre-commit): shellcheck and python syntax on staged files, bats for staged
# tests/*.bats only. The heavy checks (catalog/compose drift, audit, the whole bats suite)
# run in CI and via a plain `bash scripts/gate.sh`, not on every commit.
#
# Activated by:  git config core.hooksPath .githooks  (scripts/bootstrap.sh and
# the first run of scripts/gate.sh both do this).
#
# Escape hatches:
#   GRID_SKIP_HOOK=1 git commit ...   # skip just this run
#   git commit --no-verify ...        # git's built-in bypass
set -euo pipefail

if [[ "${GRID_SKIP_HOOK:-0}" == "1" ]]; then
  echo "pre-commit: skipped (GRID_SKIP_HOOK=1)"
  exit 0
fi

exec "$(git rev-parse --show-toplevel)/scripts/gate.sh" --pre-commit
